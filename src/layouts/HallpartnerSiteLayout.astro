---
import '../styles/hallpartner-draft.css';
import '../styles/hallpartner-amp-footer.css';
import SiteHeader from '../components/SiteHeader.astro';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

export interface Props {
  title: string;
  description: string;
  omitCanonical?: boolean;
}
const { title, description, omitCanonical = false } = Astro.props;
const isHome = Astro.url.pathname === '/';
const canonical = !omitCanonical && Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
// Launch flag is set only for a separately verified production build.
// Preview remains noindex unless the exact release opts in.
const publicLaunch = import.meta.env.PUBLIC_HP_PUBLIC_LAUNCH === 'true';
const shouldIndex = publicLaunch && !['/404/', '/404.html', '/offert/tack/', '/integritet/'].includes(Astro.url.pathname);
const useAmpFooter = process.env.HALLPARTNER_FOOTER_MODE !== 'legacy';
const ampFooterHtml = useAmpFooter
  ? readFileSync(join(process.cwd(), '.generated', 'amp-003-footer.html'), 'utf8')
  : '';
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {shouldIndex ? (
      <meta name="robots" content="index,follow" />
    ) : (
      <meta name="robots" content="noindex,nofollow" />
    )}
    <title>{title} | Hallpartner</title>
    <meta name="description" content={description} />
    {canonical && (
      <>
        <link rel="canonical" href={canonical} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Hallpartner" />
        <meta property="og:title" content={`${title} | Hallpartner`} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
      </>
    )}
    <link rel="icon" type="image/png" href="/favicon.png" />
    {useAmpFooter && <link rel="stylesheet" href="/generated/amp-003-footer.css" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@400..700&family=Saira:wght@500;600&display=swap" />
  </head>
  <body class="hp-draft hp-site hp-amp-site-header" data-header-mode={isHome ? 'hero' : 'solid'}>
    <a class="hp-draft-skip" href="#main-content">Hoppa till innehållet</a>
    <SiteHeader overlayHero={isHome} />
    <main id="main-content" class="hp-draft-main" tabindex="-1">
      <slot />
    </main>
    {useAmpFooter ? (
      <Fragment set:html={ampFooterHtml} />
    ) : (
      <footer class="hp-draft-footer">
        <div class="hp-draft-rail hp-draft-footer__inner">
          <div>
            <p class="hp-draft-footer__brand">Hallpartner</p>
            <p class="hp-draft-footer__note">Utforska olika halltyper och börja med hur hallen ska användas.</p>
          </div>
          <div class="hp-draft-footer__links">
            <a href="/stalhallar/">Hallar</a>
            <a href="/sa-gar-det-till/">Så går det till</a>
            <a href="/om-oss/">Om Hallpartner</a>
            <a href="/kontakt/">Kontakt</a>
            <a href="/integritetspolicy/">Integritetspolicy</a>
          </div>
        </div>
      </footer>
    )}
  </body>
</html>


<!-- Saira headings trial; keep typography isolated from navigation, form fields and SMTP. -->
<style is:global>
  .hp-site {
    --hp-heading-font: 'Saira', Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --hp-body-font: 'Manrope', Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  /*
   * Apply Manrope to reading text, including the quote-flow field copy.
   * Menu typeface is scoped separately in hallpartner-amp-header.css;
   * primary CTA still uses Saira below.
   */
  .hp-site.hp-draft {
    font-family: var(--hp-body-font);
  }

  .hp-site .hp-draft-header {
    font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .hp-site .hp-quote-shell .qf {
    --quote-font-body: var(--hp-body-font);
  }

  /* Saira remains exclusive to the larger headings. */
  .hp-site .hp-draft-main :is(h1, h2, h3),
  .hp-site .hp-draft-main .hp-quote-shell .qf :is(h1, h2, h3),
  .hp-site .af--compact .af__group-heading {
    font-family: var(--hp-heading-font);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  /*
   * CTAs and action buttons use the same Saira SemiBold as headings.
   * Scope to actual actions; do not change regular links, menu labels,
   * inputs, labels, select cards or the AMP header menu-toggle icon.
   */
  .hp-site :is(#hp-amp-header-target .hm__cta, .hp-draft-nav__cta, .af__quick-link),
  .hp-site .hp-draft-main :is(
    button,
    .hp-home-button,
    .hp-home-textlink,
    .hp-info__button,
    .hp-info__textlink,
    .hp-info__person-more,
    .hp-draft-cta,
    .hp-contact-hero__action,
    .hp-stal__button,
    .hp-stal__text-link,
    .hp-stal__inline-link,
    .hp-detail__button,
    .hp-detail__text-link,
    .hp-halls-button,
    .hp-detail__related a,
    .hp-detail__related-inline a
  ) {
    font-family: var(--hp-heading-font);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
</style>
