---
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/typography.css';
import '../styles/utilities.css';
import SeoHead from '../components/SeoHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image, noindex = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const currentPage = Astro.url.pathname;
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Projektets presentationsfavicon. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />

    <!-- Webfont (ingen fontfil checkas in) — se docs/DESIGN_SYSTEM.md -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <SeoHead
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      noindex={noindex}
    />

    <script is:inline>
      // Sätter en klass så att CSS kan skilja på JS-aktiverade och
      // icke-JS-besökare. Utan denna klass förblir allt innehåll synligt
      // som standard (progressiv förbättring, inga hårda JS-beroenden).
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Hoppa till huvudinnehållet</a>
    <Header currentPage={currentPage} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    inset: var(--space-1) auto auto var(--space-1);
    z-index: 100;
    padding: var(--space-1) var(--space-2);
    color: var(--color-off-white);
    background-color: var(--color-graphite);
    border-radius: var(--radius-sm);
    transform: translateY(calc(-100% - var(--space-2)));
    transition: transform var(--transition-fast);
  }

  .skip-link:focus {
    transform: translateY(0);
  }
</style>
