---
import HallpartnerSiteLayout from '../../layouts/HallpartnerSiteLayout.astro';
import '../../styles/hallpartner-info.css';
import '../../styles/hallpartner-leads.css';
import '@amelio/web-platform/quote-flow/style.css';

// Submit must remain fail-closed unless the separately deployed private V2
// receiver and published privacy terms have been verified for this exact host.
// All flags default to false on preview and must be set in a reviewed release.
const ready =
  import.meta.env.PUBLIC_HP_QUOTE_SUBMISSIONS_ENABLED === 'true' &&
  import.meta.env.PUBLIC_HP_RECEIVER_VERIFIED === 'true' &&
  import.meta.env.PUBLIC_HP_PRIVACY_APPROVED === 'true';
const filesReview = !ready && import.meta.env.PUBLIC_HP_QUOTE_FILES_REVIEW === 'true';
---

<HallpartnerSiteLayout
  title="Begär offert"
  description="Beskriv behov, ungefärliga mått och projektläge i Hallpartners offertguide. Ingen automatisk prisberäkning eller beställning."
>
  <div class="hp-quote-shell">
    <nav class="hp-draft-rail hp-info__crumbs" aria-label="Brödsmulor">
      <a href="/">Start</a><span aria-hidden="true">/</span><span aria-current="page">Offert</span>
    </nav>
    <div class="hp-draft-rail hp-quote-shell__lead">
      <p class="hp-quote-shell__eyebrow">Offertförfrågan</p>
      <h1>Berätta om hallen du planerar</h1>
      <p>Beskriv vad hallen ska användas till och ungefär hur stor den behöver vara. Du behöver inte kunna alla tekniska detaljer – vi börjar med ditt behov.</p>
    </div>
    <p class:list={['hp-leads-note', 'hp-quote-shell__notice', { 'hp-leads-note--review': !ready }]} id="hp-offert-notice">
      {ready
        ? <>Din offertförfrågan skickas till vår mottagare när du väljer Skicka förfrågan. Skicka inte känsliga personuppgifter. Läs <a href="/integritet/">hur vi hanterar dina uppgifter</a>.</>
        : filesReview
          ? 'Arbetsversion: du kan prova alla sex steg och välja bilder eller dokument. Inga uppgifter eller filer skickas till Hallpartner.'
          : 'Arbetsversion: prova guiden med sex steg. Inskickning är avstängd. Kontakta Hallpartner via telefon eller mejl om du vill göra en riktig förfrågan.'}
    </p>
    <div class="hp-draft-rail" id="hp-offert-guide" data-enabled={String(ready)} data-files-review={String(filesReview)}
      aria-describedby="hp-offert-notice"></div>
    <noscript><p class="hp-draft-rail">Guiden behöver JavaScript. <a href="/kontakt/">Kontakta Hallpartner här.</a></p></noscript>
    <p class="hp-draft-rail hp-quote-shell__fallback">Vill du börja med ett samtal? <a href="/kontakt/">Se kontaktuppgifter</a>.</p>
  </div>
</HallpartnerSiteLayout>

<script>
  import { mountQuoteFlow, createJsonAdapter } from '@amelio/web-platform/quote-flow';
  import type { Adapter, UploadIntegration } from '@amelio/web-platform/quote-flow';
  import { hallpartnerQuoteConfig } from '../../config/hallpartner-quote';
  import { hallpartnerQuoteAttachmentsReviewConfig } from '../../config/hallpartner-quote-attachments-review';
  const host = document.querySelector<HTMLElement>('#hp-offert-guide');
  if (host) {
    const reviewFiles = host.dataset.filesReview === 'true';
    // Fail closed on every submission route; there is no active quote receiver.
    const blocked: Adapter = async () => ({ status: 'failed' });
    const reviewOnlyUploads: UploadIntegration = {
      async upload() { throw new Error('Filuppladdningen är inte aktiverad.'); },
      async submit() { return { status: 'failed' }; }
    };
    const adapter: Adapter = host.dataset.enabled === 'true'
      ? createJsonAdapter('/api/lead.php') : blocked;
    const instance = mountQuoteFlow(host,
      reviewFiles ? hallpartnerQuoteAttachmentsReviewConfig : hallpartnerQuoteConfig,
      adapter,
      reviewFiles ? { timeoutMs: 15000, uploads: reviewOnlyUploads } : { timeoutMs: 15000 });
    const protect = () => {
      if (host.dataset.enabled === 'true') return;
      for (const button of host.querySelectorAll<HTMLButtonElement>('button[type="submit"]')) {
        if (button.textContent?.includes('Skicka förfrågan')) {
          button.disabled = true;
          button.title = 'Arbetsversion. Inskickning är inte aktiverad.';
        }
      }
    };
    // A capture-phase guard also blocks submit events invoked before the
    // MutationObserver runs. This avoids relying on disabled-button timing.
    host.addEventListener('submit', event => {
      if (host.dataset.enabled === 'true') return;
      const finalButton = host.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (!finalButton?.textContent?.includes('Skicka förfrågan')) return;
      event.preventDefault();
      event.stopImmediatePropagation();
      protect();
    }, { capture: true });
    const observer = new MutationObserver(protect);
    observer.observe(host, { childList: true, subtree: true });
    protect();
    window.addEventListener('pagehide', () => { observer.disconnect(); instance.destroy(); }, { once: true });
  }
</script>
