---
import { Image } from 'astro:assets';
import storagePhoto from '../../../assets/images/legacy/lagerhall-med-enkelplat.jpg';
import HallpartnerSiteLayout from '../../../layouts/HallpartnerSiteLayout.astro';
import '../../../styles/hallpartner-hall-detail.css';

// New content draft for the actual route. Business facts and available
// construction options still require Hallpartner / supplier verification.
const contactHref = '/kontakt/';

const storageNeeds = [
  {
    heading: 'Vad ska lagras?',
    body: 'Varor, material och utrustning kan ha olika krav på tillgänglighet och inomhusmiljö. Beskriv vad som ska få plats och hur ofta det behöver hanteras.',
  },
  {
    heading: 'Hur rör sig godset?',
    body: 'Lastning, lossning och förflyttningar påverkar hur ytor och portar behöver planeras. Fundera på vilka fordon som används och var de ska komma fram.',
  },
  {
    heading: 'Hur används lagret över tid?',
    body: 'En verksamhet kan växa eller förändras. Ta med både dagens behov och sådant du redan vet kan bli aktuellt längre fram.',
  },
] as const;

const flow = [
  { title: 'Vägen till porten', detail: 'Tänk igenom hur leveranser når byggnaden och hur gods tas in och ut. Fordon och trafikytor behöver kunna hanteras på plats.' },
  { title: 'Ytan innanför', detail: 'Skilj mellan det som ska förvaras, gångar och plats för hantering. En stor golvyta fungerar inte automatiskt som ett bra lager.' },
  { title: 'Det som behöver vara lätt att nå', detail: 'Beskriv vilka varor eller arbetsmoment som förekommer ofta. De påverkar hur utrymmet behöver disponeras.' },
] as const;

const faq = [
  { question: 'Hur stor lagerhall behöver jag?', answer: 'Börja med en uppskattning av det som ska förvaras och hur det hanteras. Frihöjd, gångar, portar och eventuellt framtida behov behöver också vägas in innan ett faktiskt mått bestäms.' },
  { question: 'Behöver en lagerhall vara isolerad?', answer: 'Det beror på vad som ska lagras och vilka krav som finns på temperatur och fukt. En del användningar behöver främst väderskydd, medan andra kan kräva särskild inomhusmiljö.' },
  { question: 'Vad påverkar priset på en lagerhall?', answer: 'Storlek, byggplats, stomme, tak och väggar, portar och eventuell isolering är relevanta delar. För att jämföra priser behöver du också veta vad som ingår i leveransen.' },
] as const;
---

<HallpartnerSiteLayout
  title="Lagerhallar för förvaring och logistik"
  description="Planerar du en lagerhall? Läs om förvaring, varuflöde, portar och inomhusmiljö. Få hjälp att förbereda ett första samtal om ditt lagerprojekt."
>
  <div class="hp-detail hp-detail--storage">
    <nav class="hp-detail__crumbs hp-draft-rail" aria-label="Brödsmulor">
      <a href="/">Start</a>
      <span aria-hidden="true">/</span>
      <a href="/stalhallar/">Stålhallar</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Lagerhallar</span>
    </nav>

    <section class="hp-detail__hero" aria-labelledby="hp-storage-page-title">
      <div class="hp-draft-rail hp-detail__hero-grid">
        <div class="hp-detail__hero-copy">
          <p class="hp-detail__eyebrow">Lagerhallar / Förvaring</p>
          <h1 id="hp-storage-page-title">Lagerhallar – börja med <em>förvaringen.</em></h1>
          <p class="hp-detail__lead">
            En lagerhall ska ge plats åt mer än själva godset. Hur varor kommer in,
            flyttas och hämtas ut påverkar vilka ytor som behövs.
            Börja med användningen, så blir det lättare att diskutera hallens utförande.
          </p>
          <div class="hp-detail__hero-actions">
            <a class="hp-detail__button" href="#lagerbehov">Planera lagerbehovet <span aria-hidden="true">↓</span></a>
            <a class="hp-detail__text-link" href={contactHref}>Kontakta Hallpartner <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <aside class="hp-detail__hero-aside" aria-label="Att fundera på inför en lagerhall">
          <p class="hp-detail__aside-title">Tre frågor före ritningen</p>
          <dl>
            <div><dt>Innehållet</dt><dd>Vad behöver förvaras och hur mycket plats tar det?</dd></div>
            <div><dt>Rörelserna</dt><dd>Hur kommer varorna in och ut ur hallen?</dd></div>
            <div><dt>Miljön</dt><dd>Räcker väderskydd eller finns särskilda klimatbehov?</dd></div>
          </dl>
        </aside>
      </div>
    </section>

    <nav class="hp-detail__jump" aria-label="På den här sidan">
      <div class="hp-draft-rail hp-detail__jump-inner">
        <span>På den här sidan</span>
        <a href="#lagerbehov">Lagerbehov</a>
        <a href="#varuflode">Varuflödet</a>
        <a href="#lagerutforande">Hallens utförande</a>
        <a href="#lagerfragor">Vanliga frågor</a>
      </div>
    </nav>

    <section id="lagerbehov" class="hp-detail__section hp-detail__section--paper" aria-labelledby="storage-needs-title">
      <div class="hp-draft-rail">
        <div class="hp-detail__heading-row">
          <div>
            <p class="hp-detail__eyebrow">Börja med innehållet</p>
            <h2 id="storage-needs-title">Vilket lager behöver du plats för?</h2>
          </div>
          <p>
            Det går att uppskatta ytan tidigt, men ett användbart lager behöver
            planeras efter både innehållet och hur det faktiskt hanteras.
          </p>
        </div>
        <div class="hp-detail__cards">
          {storageNeeds.map((item) => (
            <article class="hp-detail__card">
              <h3>{item.heading}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
        <div class="hp-detail__note">
          <strong>Tips inför första samtalet:</strong>
          <span>Samla gärna ungefärliga mått på det som ska förvaras och information om vilka fordon som används vid lastning.</span>
        </div>
      </div>
    </section>

    <section id="varuflode" class="hp-detail__section hp-detail__section--soft" aria-labelledby="storage-flow-title">
      <div class="hp-draft-rail hp-detail__split hp-detail__media-row">
        <div>
          <div class="hp-detail__section-intro">
            <p class="hp-detail__eyebrow">Från port till förvaring</p>
            <h2 id="storage-flow-title">Ett lager måste fungera när det används.</h2>
            <p>
              Tänk dig en vanlig leverans. Var stannar fordonet? Hur tas godset
              in i hallen? Vilka ytor behöver vara fria när arbetet pågår?
            </p>
            <a class="hp-detail__text-link" href="/stalhallar/maskinhall/">
              Behöver du också plats för maskiner? <span aria-hidden="true">→</span>
            </a>
          </div>
          <div class="hp-detail__stack">
            {flow.map((item) => (
              <article class="hp-detail__stack-item">
                <h3>{item.title}</h3>
                <p>{item.detail}</p>
              </article>
            ))}
          </div>
        </div>
        <Image
          src={storagePhoto}
          alt="Plåtklädd lagerhall med stor öppen port."
          class="hp-detail__content-image"
          widths={[320, 480, 590]}
          sizes="(max-width: 600px) calc(100vw - 2rem), (max-width: 980px) 590px, (max-width: 1260px) 48vw, 590px"
          loading="lazy"
        />
      </div>
    </section>

    <section id="lagerutforande" class="hp-detail__section hp-detail__section--dark" aria-labelledby="storage-construction-title">
      <div class="hp-draft-rail">
        <div class="hp-detail__heading-row hp-detail__heading-row--light">
          <div>
            <p class="hp-detail__eyebrow">När lagerbehovet är tydligt</p>
            <h2 id="storage-construction-title">Välj utförande efter användningen.</h2>
          </div>
          <p>
            Plåt, dukbeklädnad och isolering beskriver olika val.
            Vilken kombination som är lämplig beror på projektets
            förutsättningar och behöver utredas innan den bestäms.
          </p>
        </div>
        <div class="hp-detail__related">
          <article>
            <p class="hp-detail__mini-label">Inomhusmiljö</p>
            <h3>Behövs isolering?</h3>
            <p>För material som behöver särskild temperatur eller fukthantering blir inomhusmiljön en viktig del av planeringen.</p>
            <a href="/stalhallar/isolerad-hall/">Läs om isolerade hallar <span aria-hidden="true">→</span></a>
          </article>
          <article>
            <p class="hp-detail__mini-label">Väggar och tak</p>
            <h3>Vilket utförande passar?</h3>
            <p>Väggar, tak och eventuella öppningar behöver väljas utifrån hur lagret används och var byggnaden ska stå.</p>
            <a href="/stalhallar/plathall/">Läs om plåthallar <span aria-hidden="true">→</span></a>
          </article>
        </div>
      </div>
    </section>

    <section id="lagerfragor" class="hp-detail__section hp-detail__section--paper" aria-labelledby="storage-faq-title">
      <div class="hp-draft-rail hp-detail__split">
        <div class="hp-detail__section-intro">
          <p class="hp-detail__eyebrow">För dig som planerar</p>
          <h2 id="storage-faq-title">Vanliga frågor om lagerhallar</h2>
          <p>Du behöver inte ha ett färdigt förslag för att kunna ställa de första frågorna.</p>
        </div>
        <div class="hp-detail__faq-list">
          {faq.map((item) => (
            <article>
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="hp-detail__end" aria-labelledby="storage-next-title">
      <div class="hp-draft-rail hp-detail__end-inner">
        <div>
          <p class="hp-detail__eyebrow">Nästa steg</p>
          <h2 id="storage-next-title">Berätta hur ditt lager ska fungera.</h2>
          <p>
            Beskriv vad som ska förvaras, vilken plats du tror behövs och var hallen
            är tänkt att stå. Då finns ett konkret underlag att börja med.
          </p>
        </div>
        <a class="hp-detail__button" href={contactHref}>Kontakta Hallpartner <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </div>
</HallpartnerSiteLayout>
