---
import PresentationLayout from '../layouts/PresentationLayout.astro';
import Hero from '../components/Hero.astro';
import SectionIntro from '../components/SectionIntro.astro';
import StrengthGrid from '../components/StrengthGrid.astro';
import CustomerQuestions from '../components/CustomerQuestions.astro';
import CustomerJourney from '../components/CustomerJourney.astro';
import ConversationPrompt from '../components/ConversationPrompt.astro';
import OpportunitySection from '../components/OpportunitySection.astro';
import PreserveValuesSection from '../components/PreserveValuesSection.astro';
import WorkshopQuestions from '../components/WorkshopQuestions.astro';
import VisionOverview from '../components/VisionOverview.astro';
import BrowserMockup from '../components/BrowserMockup.astro';
import ButtonLink from '../components/ButtonLink.astro';
import RoadmapTimeline from '../components/RoadmapTimeline.astro';
import ResultsGrid from '../components/ResultsGrid.astro';
import CTASection from '../components/CTASection.astro';

import {
  homeHero,
  strengthsIntro,
  coreStrengths,
  visitorPerspective,
  decisionJourneyIntro,
  decisionJourneySteps,
  decisionJourneyNote,
  decisionJourneyPrompt,
  opportunitiesIntro,
  opportunityCards,
  preserveValuesIntro,
  preserveValues,
  workshopIntro,
  workshopGroups,
  visionOverviewIntro,
  visionOverviewItems,
  startPageTeaser,
  workingProcessIntro,
  workingProcessPhases,
  workingProcessCta,
  businessValueIntro,
  businessValueItems,
  presentationClosing,
} from '../data/presentation';
---

<PresentationLayout
  title="Hallpartner – digital analys och vision"
  description="En analys och vision för hur Hallpartner kan skapa en tydligare digital kundresa, stärka förtroendet och stödja försäljningen."
>
  <!-- 1. Hero -->
  <Hero
    eyebrow={homeHero.eyebrow}
    title={homeHero.title}
    body={homeHero.body}
    primaryCTA={homeHero.primaryCTA}
    secondaryCTA={homeHero.secondaryCTA}
    imageLabel="TODO: Bild som visar Hallpartners arbete i verkligheten"
  />

  <!-- 2. Det här fungerar redan bra -->
  <section class="section section-surface" id="grund" aria-labelledby="grund-heading">
    <div class="container">
      <SectionIntro id="grund-heading" title={strengthsIntro.title} intro={strengthsIntro.text} />
      <StrengthGrid items={coreStrengths} />
    </div>
  </section>

  <!-- 3. Min utgångspunkt -->
  <section class="section" id="utgangspunkt" aria-labelledby="utgangspunkt-heading">
    <div class="container">
      <CustomerQuestions
        id="utgangspunkt-heading"
        title={visitorPerspective.title}
        intro={visitorPerspective.intro}
        questions={visitorPerspective.questions}
        closing={visitorPerspective.closing}
      />
    </div>
  </section>

  <!-- 4. Så tror jag att kunden väljer leverantör -->
  <section class="section section-surface" id="kundresa" aria-labelledby="kundresa-heading">
    <div class="container">
      <SectionIntro id="kundresa-heading" title={decisionJourneyIntro.title} />
      <CustomerJourney steps={decisionJourneySteps} />
      <p class="text-body text-muted kundresa-note">{decisionJourneyNote}</p>
      <ConversationPrompt question={decisionJourneyPrompt} />
    </div>
  </section>

  <!-- 5. Här ser jag den största potentialen -->
  <section class="section" id="mojligheter" aria-labelledby="mojligheter-heading">
    <div class="container">
      <OpportunitySection id="mojligheter-heading" title={opportunitiesIntro.title} cards={opportunityCards} />
    </div>
  </section>

  <!-- 6. Det här vill jag inte förändra -->
  <section class="section section-inverse" id="oforandrat" aria-labelledby="oforandrat-heading">
    <div class="container">
      <SectionIntro
        id="oforandrat-heading"
        title={preserveValuesIntro.title}
        intro={preserveValuesIntro.text}
      />
      <PreserveValuesSection items={preserveValues} />
    </div>
  </section>

  <!-- 7. Frågor jag gärna vill diskutera -->
  <section class="section section-surface" id="fragor" aria-labelledby="fragor-heading">
    <div class="container">
      <SectionIntro id="fragor-heading" title={workshopIntro.title} />
      <WorkshopQuestions groups={workshopGroups} />
    </div>
  </section>

  <!-- 8. Min vision -->
  <section class="section" id="vision" aria-labelledby="vision-heading">
    <div class="container">
      <SectionIntro
        id="vision-heading"
        title={visionOverviewIntro.title}
        intro={visionOverviewIntro.text}
      />
      <VisionOverview items={visionOverviewItems} />
    </div>
  </section>

  <!-- 9. Se ett möjligt startsidesförslag -->
  <section class="section section-surface" id="startsideforslag" aria-labelledby="startsideforslag-heading">
    <div class="container two-col">
      <div class="two-col__text">
        <h2 id="startsideforslag-heading">{startPageTeaser.title}</h2>
        <p class="text-lead text-muted">{startPageTeaser.text}</p>
        <div class="two-col__actions">
          <ButtonLink href={startPageTeaser.cta.href} label={startPageTeaser.cta.label} variant="primary" />
          <ButtonLink
            href={startPageTeaser.secondaryCta.href}
            label={startPageTeaser.secondaryCta.label}
            variant="ghost"
          />
        </div>
      </div>
      <div class="two-col__media">
        <BrowserMockup
          imageLabel="TODO: Skärmbild av startsidesförslaget"
          caption="Förslag på Hallpartners nya startsida."
          url="hallpartner.se"
        />
      </div>
    </div>
  </section>

  <!-- 10. Möjligt arbetssätt -->
  <section class="section" id="arbetssatt" aria-labelledby="arbetssatt-heading">
    <div class="container">
      <SectionIntro id="arbetssatt-heading" title={workingProcessIntro.title} />
      <RoadmapTimeline phases={workingProcessPhases} />
      <div class="section-footer-cta">
        <ButtonLink href={workingProcessCta.href} label={workingProcessCta.label} variant="ghost" />
      </div>
    </div>
  </section>

  <!-- 11. Förväntad affärsnytta -->
  <section class="section section-surface" id="affarsnytta" aria-labelledby="affarsnytta-heading">
    <div class="container">
      <SectionIntro id="affarsnytta-heading" title={businessValueIntro.title} />
      <ResultsGrid results={businessValueItems} />
    </div>
  </section>

  <!-- 12. Avslutning -->
  <CTASection
    title={presentationClosing.title}
    text={presentationClosing.text}
    button={presentationClosing.button}
    secondaryButton={presentationClosing.secondaryButton}
  />
</PresentationLayout>

<style>
  .two-col {
    display: grid;
    gap: var(--space-4);
    align-items: center;
  }

  .two-col__text > * + * {
    margin-top: var(--space-2);
  }

  .two-col__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .kundresa-note {
    max-width: var(--width-text);
    margin-top: var(--space-4);
  }

  .section-footer-cta {
    margin-top: var(--space-4);
  }

  @media (min-width: 768px) {
    .two-col {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-5);
    }
  }
</style>
