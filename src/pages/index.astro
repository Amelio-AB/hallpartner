---
import PresentationLayout from '../layouts/PresentationLayout.astro';
import Hero from '../components/Hero.astro';
import SectionIntro from '../components/SectionIntro.astro';
import StrengthGrid from '../components/StrengthGrid.astro';
import CustomerQuestions from '../components/CustomerQuestions.astro';
import CustomerJourney from '../components/CustomerJourney.astro';
import ConversationPrompt from '../components/ConversationPrompt.astro';
import OpportunitySection from '../components/OpportunitySection.astro';
import ButtonLink from '../components/ButtonLink.astro';
import RoadmapTimeline from '../components/RoadmapTimeline.astro';
import ResultsGrid from '../components/ResultsGrid.astro';
import CTASection from '../components/CTASection.astro';
import heroImage from '../assets/images/talthall.jpg';

import {
  homeHero,
  strengthsIntro,
  coreStrengths,
  decisionJourneyIntro,
  decisionJourneySteps,
  decisionJourneyNote,
  decisionJourneyPrompt,
  opportunitiesIntro,
  opportunityCards,
  visionOverviewIntro,
  meetingQuestions,
  workingProcessIntro,
  workingProcessPhases,
  workingProcessCta,
  businessValueIntro,
  businessValueItems,
  presentationClosing,
} from '../data/presentation';
---

<PresentationLayout
  title="Hallpartner – digital analys och vision"
  description="En analys och vision för hur Hallpartner kan skapa en tydligare digital kundresa, stärka förtroendet och stödja försäljningen."
>
  <!-- 1. Hero -->
  <Hero
    eyebrow={homeHero.eyebrow}
    title={homeHero.title}
    body={homeHero.body}
    primaryCTA={homeHero.primaryCTA}
    image={heroImage}
  />

  <!-- 2. Styrkorna som redan finns -->
  <section class="section section-surface" id="grund" aria-labelledby="grund-heading">
    <div class="container">
      <SectionIntro id="grund-heading" title={strengthsIntro.title} intro={strengthsIntro.text} />
      <StrengthGrid items={coreStrengths} />
      <p class="text-lead strengths-note">
        Det här är värden jag vill göra tydligare digitalt — inte förändra.
      </p>
    </div>
  </section>

  <!-- 3. Kundens väg till beslut -->
  <section class="section" id="kundresa" aria-labelledby="kundresa-heading">
    <div class="container">
      <SectionIntro id="kundresa-heading" title={decisionJourneyIntro.title} />
      <CustomerJourney steps={decisionJourneySteps} />
      <p class="text-body text-muted kundresa-note">{decisionJourneyNote}</p>
      <ConversationPrompt question={decisionJourneyPrompt} />
    </div>
  </section>

  <!-- 4. Den största digitala potentialen -->
  <section class="section section-surface" id="mojligheter" aria-labelledby="mojligheter-heading">
    <div class="container">
      <OpportunitySection
        id="mojligheter-heading"
        title={opportunitiesIntro.title}
        text={opportunitiesIntro.text}
        cards={opportunityCards}
      />
    </div>
  </section>

  <!-- 5. Min vision -->
  <section
    class="section section-inverse vision-statement"
    id="vision"
    aria-labelledby="vision-heading"
  >
    <div class="container">
      <SectionIntro
        id="vision-heading"
        title={visionOverviewIntro.title}
        intro={visionOverviewIntro.text}
      />
    </div>
  </section>

  <!-- 6. Frågor som avgör vad som är rätt att bygga -->
  <section class="section" id="fragor" aria-labelledby="fragor-heading">
    <div class="container">
      <CustomerQuestions
        id="fragor-heading"
        title={meetingQuestions.title}
        intro={meetingQuestions.intro}
        questions={meetingQuestions.questions}
        closing={meetingQuestions.closing}
      />
    </div>
  </section>

  <!-- 7. Möjligt arbetssätt -->
  <section class="section section-surface" id="arbetssatt" aria-labelledby="arbetssatt-heading">
    <div class="container">
      <SectionIntro id="arbetssatt-heading" title={workingProcessIntro.title} />
      <RoadmapTimeline phases={workingProcessPhases} />
      <div class="section-footer-cta">
        <ButtonLink href={workingProcessCta.href} label={workingProcessCta.label} variant="ghost" />
      </div>
    </div>
  </section>

  <!-- 8. Förväntad affärsnytta -->
  <section class="section" id="affarsnytta" aria-labelledby="affarsnytta-heading">
    <div class="container">
      <SectionIntro id="affarsnytta-heading" title={businessValueIntro.title} />
      <ResultsGrid results={businessValueItems} />
    </div>
  </section>

  <!-- 9. Avslutande dialog -->
  <CTASection
    title={presentationClosing.title}
    text={presentationClosing.text}
    button={presentationClosing.button}
  />
</PresentationLayout>

<style>
  .kundresa-note {
    max-width: var(--width-text);
    margin-top: var(--space-4);
  }

  .strengths-note {
    max-width: var(--width-text);
    margin-top: var(--space-5);
    padding-left: var(--space-3);
    border-left: 3px solid var(--color-accent-warm);
  }

  .vision-statement :global(.section-intro) {
    max-width: 52rem;
  }

  .section-footer-cta {
    margin-top: var(--space-4);
  }
</style>
