---
import HallpartnerSiteLayout from '../../layouts/HallpartnerSiteLayout.astro';
import '../../styles/hallpartner-info.css';
import '../../styles/hallpartner-contact-hero.css';
import '../../styles/hallpartner-contact-details.css';
import ContactForm from '../../components/ContactForm.astro';
import { hallpartnerContact, hallpartnerPeople } from '../../config/hallpartner-people';

// Published on the former Hallpartner WordPress footer (2026-11-01 review).
// Customer verification of ownership, recipient and current phone is still
// required before launch (HP-015 and HP-007). No backend or form is implied.
const contactEmail = hallpartnerContact.email;

const preparations = [
  { title: 'Vad hallen ska användas till', description: 'Beskriv gärna verksamheten och vad som behöver få plats – exempelvis varor, maskiner eller annan utrustning.' },
  { title: 'Ungefärliga mått', description: 'Har du redan en uppfattning om bredd, längd och höjd? Skicka med den. Det behöver inte vara färdigprojekterat.' },
  { title: 'Var projektet planeras', description: 'Byggort och kända förutsättningar på platsen är bra information inför det första samtalet.' },
] as const;
---

<HallpartnerSiteLayout
  title="Kontakt"
  description="Kontakta Hallpartner om ett planerat hallprojekt. Se telefonnummer och e-post samt vilka uppgifter som är bra att förbereda innan du hör av dig."
>
  <div class="hp-info hp-info--contact">
    <nav class="hp-info__crumbs hp-draft-rail" aria-label="Brödsmulor">
      <a href="/">Start</a><span aria-hidden="true">/</span><span aria-current="page">Kontakt</span>
    </nav>

    <section class="hp-info__hero" aria-labelledby="contact-title">
      <div class="hp-draft-rail hp-info__hero-grid">
        <div class="hp-info__intro">
          <p class="hp-info__eyebrow">Hallpartner / Kontakt</p>
          <h1 id="contact-title">Berätta om <em>ditt hallprojekt.</em></h1>
          <p class="hp-info__lead">
            Behöver du en hall för förvaring, maskiner eller en annan verksamhet?
            Börja med att beskriva vad du har i åtanke. Du behöver inte ha
            alla detaljer klara för att ta den första kontakten.
          </p>
          <nav class="hp-contact-hero__actions" aria-label="Snabbkontakt">
            <a class="hp-contact-hero__action" href="#hallpartner-telefon">
              Visa telefonnummer <span aria-hidden="true">↓</span>
            </a>
            <a class="hp-contact-hero__action" href="#hallpartner-epost">
              Visa e-postadress <span aria-hidden="true">↓</span>
            </a>
          </nav>
          <a class="hp-info__textlink hp-contact-hero__prep-link" href="#infor-kontakt">
            Vad behöver jag förbereda? <span aria-hidden="true">↓</span>
          </a>
        </div>

        <ContactForm />
      </div>
    </section>

    <nav class="hp-info__jump" aria-label="På den här sidan">
      <div class="hp-draft-rail hp-info__jump-inner">
        <span>På den här sidan</span>
        <a href="#kontaktuppgifter">Kontaktuppgifter</a>
        <a href="#personer">Peter och Jimmy</a>
        <a href="#infor-kontakt">Förbered din fråga</a>
        <a href="#nasta-steg">Nästa steg</a>
      </div>
    </nav>

    <section class="hp-info__section hp-info__section--soft hp-contact-directory" id="kontaktuppgifter"
      aria-labelledby="hallpartner-contact-details-heading">
      <div class="hp-draft-rail">
        <div class="hp-info__heading-row">
          <div>
            <p class="hp-info__eyebrow">Gemensam kontakt</p>
            <h2 id="hallpartner-contact-details-heading">Kontakta Hallpartner.</h2>
          </div>
          <p>Vill du ringa eller mejla? Här hittar du företagets gemensamma kontaktvägar. Längre ned kan du läsa mer om Peter och Jimmy.</p>
        </div>
        <div class="hp-contact-directory__grid">
          <div class="hp-contact-directory__card">
            <div class="hp-contact-directory__entry">
              <h3 id="hallpartner-telefon" tabindex="-1">Telefon · växel</h3>
              <a class="hp-contact-directory__value" href={hallpartnerContact.phoneHref}>{hallpartnerContact.phone}</a>
              <p>Ring om du vill diskutera ditt hallprojekt med oss.</p>
            </div>
            <div class="hp-contact-directory__entry">
              <h3 id="hallpartner-epost" tabindex="-1">E-post · gemensam</h3>
              <a class="hp-contact-directory__value" href={'mailto:' + contactEmail}>{contactEmail}</a>
              <p>Beskriv gärna kort vad du behöver hjälp med.</p>
            </div>
            <div class="hp-contact-directory__company">
              <h3>Företagsuppgifter</h3>
              <p>{hallpartnerContact.legalName}</p>
              <p>Organisationsnummer: {hallpartnerContact.organisationNumber}</p>
            </div>
          </div>
          <div class="hp-contact-directory__visit" aria-labelledby="hallpartner-visit-heading">
            <p class="hp-info__eyebrow">Besök och vägbeskrivning</p>
            <h3 id="hallpartner-visit-heading">Hitta till oss.</h3>
            {hallpartnerContact.visitAddress ? (
              <p>{hallpartnerContact.visitAddress}</p>
            ) : (
              <>
                <p>Vill du komma förbi? Kontakta oss för att boka ett besök.</p>
                <p class="hp-contact-directory__pending">
                  Vi visar karta och vägbeskrivning här när Hallpartners besöksadress är bekräftad.
                </p>
              </>
            )}
          </div>
        </div>
      </div>
    </section>

    <section class="hp-info__section hp-info__section--light hp-info__team-contact" id="personer" aria-labelledby="contact-people-heading">
      <div class="hp-draft-rail">
        <div class="hp-info__heading-row">
          <div>
            <p class="hp-info__eyebrow">Personlig kontakt</p>
            <h2 id="contact-people-heading">Prata med Peter eller Jimmy.</h2>
          </div>
          <p>Här ser du vilka du kan prata med på Hallpartner. Telefonnumret och mejladressen nedan är företagets gemensamma kontaktvägar.</p>
        </div>
        <div class="hp-info__people hp-info__people--contact">
          {hallpartnerPeople.map((person) => (
            <article class="hp-info__person hp-info__person--contact" aria-labelledby={person.id + '-kontakt-namn'}>
              <div class="hp-info__person-photo">
                <img src={person.portrait} alt={`Porträtt av ${person.name}`} width="886" height="887" loading="lazy" decoding="async" />
              </div>
              <div class="hp-info__person-content">
                <p class="hp-info__person-label">Hallpartner</p>
                <h3 id={person.id + '-kontakt-namn'}>{person.name}</h3>
                <p class="hp-info__person-role">{person.role}</p>
                <div class="hp-info__person-contact-links">
                  {person.directPhone && person.directPhoneHref ? (
                    <a href={person.directPhoneHref} aria-label={`Ring ${person.firstName} direkt`}>{person.directPhone}</a>
                  ) : (
                    <a href="#hallpartner-telefon" aria-label={`Visa växeln för att nå ${person.firstName}`}>Kontakta {person.firstName} via växeln</a>
                  )}
                  {person.directEmail ? (
                    <a href={'mailto:' + person.directEmail} aria-label={`Mejla ${person.firstName} direkt`}>{person.directEmail}</a>
                  ) : (
                    <a href="#hallpartner-epost" aria-label={`Visa Hallpartners e-post för att kontakta ${person.firstName}`}>Mejla Hallpartner om {person.firstName}</a>
                  )}
                </div>
                <a class="hp-info__person-more" href={`/om-oss/#${person.id}`}>Läs mer om {person.firstName} <span aria-hidden="true">→</span></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="hp-info__section hp-info__section--light" id="infor-kontakt" aria-labelledby="contact-preparation-heading">
      <div class="hp-draft-rail">
        <div class="hp-info__heading-row">
          <div>
            <p class="hp-info__eyebrow">Inför första kontakten</p>
            <h2 id="contact-preparation-heading">Tre bra saker att ta med.</h2>
          </div>
          <p>
            Uppgifterna hjälper till att göra behovet mer konkret.
            Saknar du något av underlagen kan ni börja diskutera projektet ändå.
          </p>
        </div>
        <div class="hp-info__cards">
          {preparations.map((item) => (
            <article class="hp-info__card">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="hp-info__section hp-info__section--soft" id="nasta-steg" aria-labelledby="contact-next-heading">
      <div class="hp-draft-rail hp-info__split">
        <div>
          <p class="hp-info__eyebrow">En väg vidare</p>
          <h2 id="contact-next-heading">Vill du läsa mer innan du hör av dig?</h2>
        </div>
        <div>
          <p>
            I hallöversikten kan du jämföra användningsområden och utföranden.
            På sidan om att planera ett hallprojekt finns fler frågor som kan
            vara bra att undersöka inför nästa beslut.
          </p>
          <div class="hp-info__related-links">
            <a href="/stalhallar/">Utforska stålhallar <span aria-hidden="true">→</span></a>
            <a href="/sa-gar-det-till/">Så kan du förbereda ditt projekt <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </section>
  </div>
</HallpartnerSiteLayout>
