---
/**
 * Discovery.astro
 * Frågeunderlag inför första mötet med Hallpartner.
 *
 * Använder Amelios designtokens (--color-*, --font-*, --radius-*).
 * Tokens förutsätts vara definierade globalt i :root.
 *
 * Endast de publika frågorna renderas här. Frågor om budget, beslutsordning
 * och konkurrerande leverantörer ställs muntligt och ska inte ligga på sajten.
 */

interface Props {
  eyebrow?: string;
  heading?: string;
  intro?: string;
}

const {
  eyebrow = 'Inför vårt första möte',
  heading = 'Frågor till er',
  intro = 'För att bygga rätt sak behöver jag förstå hur ni arbetar i dag – och vart ni vill.',
} = Astro.props;

const blocks = [
  {
    number: '01',
    title: 'Mål och riktning',
    questions: [
      'Vad ska sajten göra bättre än den gör i dag?',
      'Hur vet vi om ett år att det här var värt investeringen?',
      'Vad skulle få er att säga att projektet blev riktigt lyckat?',
    ],
  },
  {
    number: '02',
    title: 'Kunder och försäljning',
    questions: [
      'Hur hittar kunderna er i dag?',
      'Vilka kunder vill ni få fler av – och vilka vill ni ha färre av?',
      'Vad händer när en förfrågan kommer in? Vem tar emot den och hur snabbt svarar ni?',
      'Hur lång är vägen från första kontakt till affär?',
      'Vilket område levererar ni till i praktiken?',
    ],
  },
  {
    number: '03',
    title: 'Erbjudande och konkurrens',
    questions: [
      'Vilka typer av hallar säljer ni mest?',
      'Varför valde er senaste kund er i stället för konkurrenten?',
      'Berätta om en affär ni förlorade – vad fällde avgörandet?',
      'Finns det något ni vill sälja mer av framåt?',
    ],
  },
  {
    number: '04',
    title: 'Kundens frågor',
    questions: [
      'Vad frågar kunderna nästan alltid om?',
      'Vad brukar skapa osäkerhet eller tveksamhet?',
      'Vad behöver ni veta innan ni kan lämna en offert?',
      'Var uppstår de vanligaste missförstånden?',
    ],
  },
  {
    number: '05',
    title: 'Innehåll och bilder',
    questions: [
      'Vilka projekt är ni mest stolta över?',
      'Vilka bilder och ritningar finns – och kan jag få se dem i dag?',
      'Finns kunder som kan tänka sig att medverka i ett referenscase?',
      'Vem hos er kan bidra med innehåll, och hur mycket tid har den personen?',
    ],
  },
  {
    number: '06',
    title: 'Sajten i dag',
    questions: [
      'Vem byggde nuvarande sajt och vem uppdaterar den?',
      'Vad fungerar bra – och vad irriterar er mest?',
      'Har ni Google Analytics eller Search Console? Kan jag få tillgång?',
      'Vad vill ni kunna ändra själva, utan att ringa mig?',
    ],
  },
];
---

<section class="discovery" id="discovery">
  <div class="container">
    <header class="discovery__intro">
      <span class="eyebrow">{eyebrow}</span>
      <h2 class="discovery__heading">{heading}</h2>
      <p class="discovery__lead">{intro}</p>
    </header>

    <ol class="discovery__grid">
      {blocks.map((block) => (
        <li class="discovery__block card">
          <span class="discovery__number">{block.number}</span>
          <h3 class="discovery__title">{block.title}</h3>
          <ul class="discovery__questions">
            {block.questions.map((question) => (
              <li class="discovery__question">{question}</li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .discovery {
    padding-block: var(--section-padding);
  }

  /* --- Introblock --- */
  .discovery__intro {
    max-width: 46ch;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .discovery__heading {
    /* Mindre än global h2 – det här är en underordnad sektion, inte en hero */
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 6vw, 4.5rem);
    text-transform: uppercase;
    line-height: 0.95;
    letter-spacing: 0.035em;
    margin-block: 0.6rem 1.2rem;
  }

  .discovery__lead {
    color: var(--color-text-muted);
    font-size: 1.35rem;
    font-style: italic;
  }

  /* --- Rutnät --- */
  .discovery__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }

  .discovery__block {
    /* .card ger bakgrund, ram, radie och skugga från designsystemet */
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .discovery__number {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.16em;
    color: var(--color-primary);
  }

  .discovery__title {
    font-family: var(--font-display);
    /* Kortrubrik – betydligt mindre än global h3 */
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    text-transform: uppercase;
    line-height: 1;
    letter-spacing: 0.035em;
    color: var(--color-text);
    margin: 0;
  }

  .discovery__questions {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }

  .discovery__question {
    position: relative;
    padding-left: 1.5rem;
    color: var(--color-text-muted);
    font-size: 1.15rem;
    line-height: 1.5;
    border-top: 1px solid var(--color-border);
    padding-top: 0.7rem;
  }

  .discovery__question:first-child {
    border-top: 0;
    padding-top: 0;
  }

  /* Streck i sage istället för punktlista – lugnare, mer editorialt */
  .discovery__question::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--color-sage);
  }

  .discovery__question:first-child::before {
    top: 0;
  }

  /* --- Två kolumner från tablet och uppåt --- */
  @media (min-width: 48rem) {
    .discovery__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }

  /* --- Utskrift: kunden vill ofta ha listan på papper i mötet --- */
  @media print {
    .discovery {
      padding-block: 0;
    }

    .discovery__block {
      background: none;
      box-shadow: none;
      border: 1px solid #999;
      break-inside: avoid;
    }

    .discovery__heading,
    .discovery__title,
    .discovery__question,
    .discovery__lead,
    .discovery__number {
      color: #000;
    }
  }

  /* --- Respektera minskad rörelse --- */
  @media (prefers-reduced-motion: reduce) {
    .discovery__block {
      transition: none;
    }
  }
</style>
