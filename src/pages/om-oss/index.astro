---
import HallpartnerSiteLayout from '../../layouts/HallpartnerSiteLayout.astro';
import '../../styles/hallpartner-info.css';

import { hallpartnerPeople } from '../../config/hallpartner-people';

const topics = [
  {
    label: 'Från behov till förslag',
    body: 'Berätta hur hallen ska användas och var den ska byggas. Vi går igenom förutsättningarna och hjälper dig att diskutera en lösning med tydlig leveransomfattning.',
  },
  {
    label: 'Samordning vid totalentreprenad',
    body: 'När vi avtalar totalentreprenad kan Hallpartner samordna projektering, grundarbete, montage och installationer. Delar av arbetet utförs av våra underentreprenörer.',
  },
  {
    label: 'En driftklar hall enligt avtal',
    body: 'Nyckelfärdigt ska betyda något konkret i ditt projekt. I offerten anges vilka arbeten och installationer som ingår och hur ansvar och överlämning regleras.',
  },
] as const;
---

<HallpartnerSiteLayout
  title="Om Hallpartner – nyckelfärdiga hallar och totalentreprenad"
  description="Möt Peter och Jimmy på Hallpartner. Läs hur vi kan hjälpa dig från första hallbehovet till en nyckelfärdig och driftklar hall genom totalentreprenad."
>
  <div class="hp-info hp-info--about">
    <nav class="hp-info__crumbs hp-draft-rail" aria-label="Brödsmulor">
      <a href="/">Start</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Om Hallpartner</span>
    </nav>

    <section class="hp-info__hero" aria-labelledby="about-title">
      <div class="hp-draft-rail hp-info__hero-grid">
        <div class="hp-info__intro">
          <p class="hp-info__eyebrow">Hallpartner / Om oss</p>
          <h1 id="about-title">Människorna bakom <em>din nästa hall.</em></h1>
          <p class="hp-info__lead">
            Hos Hallpartner kan du prata direkt med Peter och Jimmy, som
            arbetar med försäljning och projektledning av hallar.
            Vi hjälper dig att gå från ett behov till en möjlig driftklar,
            nyckelfärdig hall genom totalentreprenad. Vad som ingår
            kommer vi överens om i offerten.
          </p>
          <div class="hp-info__hero-actions">
            <a class="hp-info__button" href="/offert/">
              Be om offert <span aria-hidden="true">→</span>
            </a>
            <a class="hp-info__textlink" href="#teamet">
              Möt Peter och Jimmy <span aria-hidden="true">↓</span>
            </a>
          </div>
        </div>

        <aside class="hp-info__guide" aria-labelledby="about-guide-heading">
          <h2 class="hp-info__guide-title" id="about-guide-heading">Från planering till färdig hall.</h2>
          <p>
            Vid totalentreprenad kan vi samordna arbeten som grundläggning,
            montage och avtalade installationer med hjälp av underentreprenörer.
            Vi kan också hjälpa till med bygglovsprocessen och kontakten med
            kommunen när det ingår i uppdraget.
          </p>
          <a href="/sa-gar-det-till/">
            Så går ett hallprojekt till <span aria-hidden="true">→</span>
          </a>
        </aside>
      </div>
    </section>

    <nav class="hp-info__jump" aria-label="På den här sidan">
      <div class="hp-draft-rail hp-info__jump-inner">
        <span>På den här sidan</span>
        <a href="#teamet">Personerna</a>
        <a href="#om-inriktning">Så hjälper vi</a>
        <a href="#om-kontakt">Kontakt</a>
      </div>
    </nav>

    <section class="hp-info__section hp-info__section--light" id="teamet" aria-labelledby="about-team-title">
      <div class="hp-draft-rail">
        <div class="hp-info__heading-row">
          <div>
            <p class="hp-info__eyebrow">Människorna bakom</p>
            <h2 id="about-team-title">Möt Peter och Jimmy.</h2>
          </div>
          <p>
            Peter och Jimmy arbetar med försäljning och projektledning av hallar.
            Här kan du lära känna personerna du möter när du kontaktar Hallpartner.
          </p>
        </div>
        <div class="hp-info__people hp-info__people--about">
          {hallpartnerPeople.map((person) => (
            <article class="hp-info__person hp-info__person--about" id={person.id} aria-labelledby={person.id + '-namn'}>
              <div class="hp-info__person-photo">
                <img src={person.portrait} alt={`Porträtt av ${person.name}`} width="886" height="887" loading="lazy" decoding="async" />
              </div>
              <div class="hp-info__person-content">
                <p class="hp-info__person-label">Hallpartner</p>
                <h3 id={person.id + '-namn'}>{person.name}</h3>
                <p class="hp-info__person-role">{person.role}</p>
                <p>{person.intro}</p>
                <p>{person.detail}</p>
                <a class="hp-info__person-more" href="/kontakt/#personer">Kontakta {person.firstName} <span aria-hidden="true">→</span></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="hp-info__section hp-info__section--soft" id="om-inriktning" aria-labelledby="about-focus-title">
      <div class="hp-draft-rail hp-info__split">
        <div>
          <p class="hp-info__eyebrow">Så arbetar Hallpartner</p>
          <h2 id="about-focus-title">Du beskriver vad du behöver. Vi hjälper dig att planera leveransen.</h2>
          <p>
            Det första samtalet behöver inte börja med ritningar.
            Vi utgår från hur hallen ska användas och vad som krävs
            för att den ska bli driftklar. Vid behov kan vi erbjuda
            totalentreprenad. Exakt omfattning och ansvar anges i avtalet.
          </p>
          <a class="hp-info__textlink" href="/sa-gar-det-till/">
            Se vägen till en färdig hall <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="hp-info__stack">
          {topics.map((topic) => (
            <article>
              <h3>{topic.label}</h3>
              <p>{topic.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="hp-info__end" id="om-kontakt" aria-labelledby="about-contact-title">
      <div class="hp-draft-rail hp-info__end-inner">
        <div>
          <p class="hp-info__eyebrow">Nästa steg</p>
          <h2 id="about-contact-title">Vad behöver din hall kunna göra?</h2>
          <p>
            Beskriv hur du vill använda hallen och var den ska byggas.
            Vi hjälper dig att diskutera nästa steg.
          </p>
        </div>
        <div class="hp-info__end-actions">
          <a class="hp-info__button" href="/offert/">
            Be om offert <span aria-hidden="true">→</span>
          </a>
          <a class="hp-info__textlink" href="/kontakt/">
            Ring eller mejla <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>
  </div>
</HallpartnerSiteLayout>
