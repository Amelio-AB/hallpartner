---
import HallpartnerSiteLayout from '../../layouts/HallpartnerSiteLayout.astro';
import '../../styles/hallpartner-info.css';
---

<HallpartnerSiteLayout
  title="Personuppgifter"
  description="Hallpartners integritetspolicy beskriver hur personuppgifter behandlas när du kontaktar oss."
>
  <div class="hp-info">
    <nav class="hp-info__crumbs hp-draft-rail" aria-label="Brödsmulor">
      <a href="/">Start</a><span aria-hidden="true">/</span><span aria-current="page">Personuppgifter</span>
    </nav>
    <section class="hp-info__section hp-info__section--light" aria-labelledby="privacy-title">
      <div class="hp-draft-rail" style="max-width: 860px">
        <p class="hp-info__eyebrow">Personuppgifter</p>
        <h1 id="privacy-title">Så hanterar Hallpartner personuppgifter</h1>
        <p>Den aktuella informationen finns i <a href="/integritetspolicy/">Hallpartners integritetspolicy</a>.</p>
        <p>Har du frågor kan du <a href="mailto:info@hallpartner.se">kontakta oss via e-post</a>.</p>
      </div>
    </section>
  </div>
</HallpartnerSiteLayout>
