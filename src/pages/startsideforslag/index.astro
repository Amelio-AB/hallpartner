---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import SectionIntro from '../../components/SectionIntro.astro';
import StrengthGrid from '../../components/StrengthGrid.astro';
import RoadmapTimeline from '../../components/RoadmapTimeline.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import KnowledgeGrid from '../../components/KnowledgeGrid.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import CTASection from '../../components/CTASection.astro';
import ButtonLink from '../../components/ButtonLink.astro';

import {
  startPageHero,
  services,
  hallTypes,
  industries,
  processSteps,
  trustStrengths,
  faqItems,
} from '../../data/presentation';
import { projects } from '../../data/projects';
import { knowledgeArticles } from '../../data/knowledge';

const contactCTA = { label: 'Begär offert', href: '/kontakt/', variant: 'primary' as const };
---

<BaseLayout
  title="Startsideförslag | Hallpartner — nästa kapitel"
  description="Ett trovärdigt koncept för Hallpartners framtida startsida — tjänster, halltyper, branscher, referensprojekt och arbetsprocess."
>
  <p class="concept-banner text-caption">
    TODO — Koncept: Detta är ett designförslag för Hallpartners framtida startsida. Innehållet nedan
    är strukturell platshållartext tills Hallpartner bekräftar tjänster, halltyper och branscher.
    <a href="/" class="concept-banner__link">Till analysen</a>
  </p>

  <Hero title={startPageHero.title} body={startPageHero.subtitle} primaryCTA={startPageHero.cta} />

  <section class="section" id="tjanster" aria-labelledby="tjanster-heading">
    <div class="container">
      <SectionIntro
        id="tjanster-heading"
        eyebrow="Tjänster"
        title="En helhetslösning, steg för steg."
      />
      <StrengthGrid items={services} />
    </div>
  </section>

  <section class="section section-surface" id="halltyper" aria-labelledby="halltyper-heading">
    <div class="container">
      <SectionIntro
        id="halltyper-heading"
        eyebrow="Halltyper"
        title="Hallar för varje verksamhet."
      />
      <StrengthGrid items={hallTypes} />
    </div>
  </section>

  <section class="section" id="branscher" aria-labelledby="branscher-heading">
    <div class="container">
      <SectionIntro
        id="branscher-heading"
        eyebrow="Branscher"
        title="Verksamheter vi kan stötta."
      />
      <ul class="industry-list">
        {industries.map((industry) => <li class="industry-list__item">{industry.title}</li>)}
      </ul>
    </div>
  </section>

  <section
    class="section section-surface"
    id="referensprojekt"
    aria-labelledby="referensprojekt-heading"
  >
    <div class="container">
      <SectionIntro
        id="referensprojekt-heading"
        eyebrow="Referensprojekt"
        title="Referensprojekt som bygger förtroende."
      />
      <ProjectGrid projects={projects} />
    </div>
  </section>

  <section class="section" id="process" aria-labelledby="process-heading">
    <div class="container">
      <SectionIntro
        id="process-heading"
        eyebrow="Så arbetar Hallpartner"
        title="Från idé till nyckelfärdig hall."
      />
      <RoadmapTimeline phases={processSteps} />
    </div>
  </section>

  <section class="section section-inverse" id="styrkor" aria-labelledby="styrkor-heading">
    <div class="container">
      <SectionIntro id="styrkor-heading" title="Varför Hallpartner" align="center" />
      <StrengthGrid items={trustStrengths} />
    </div>
  </section>

  <section class="section" id="kunskapsbank" aria-labelledby="kunskapsbank-heading">
    <div class="container">
      <SectionIntro
        id="kunskapsbank-heading"
        eyebrow="Kunskapsbank"
        title="Kunskap som stärker varje beslut."
      />
      <KnowledgeGrid articles={knowledgeArticles.slice(0, 3)} />
      <div class="section-footer-cta">
        <ButtonLink href="/kunskapsbank/" label="Till kunskapsbanken" variant="ghost" />
      </div>
    </div>
  </section>

  <section class="section section-surface" id="faq" aria-labelledby="faq-heading">
    <div class="container container-text">
      <SectionIntro id="faq-heading" eyebrow="FAQ" title="Vanliga frågor" />
      <FAQAccordion items={faqItems} />
    </div>
  </section>

  <CTASection title="Redo att ta nästa steg?" text={startPageHero.subtitle} button={contactCTA} />
</BaseLayout>

<style>
  .concept-banner {
    display: block;
    text-align: center;
    padding: var(--space-1) var(--space-2);
    background-color: var(--color-warm-accent);
    color: var(--color-graphite);
    font-weight: var(--font-weight-semibold);
  }

  .concept-banner__link {
    margin-left: var(--space-2);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .industry-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .industry-list__item {
    padding: 0.6rem 1.25rem;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-pill);
    font-size: var(--font-size-body);
  }

  .section-footer-cta {
    margin-top: var(--space-4);
  }
</style>
