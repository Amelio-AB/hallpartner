---
export interface Props {
  imageLabel?: string;
  caption?: string;
  url?: string;
}

const {
  imageLabel = 'TODO: Skärmbild av konceptet',
  caption,
  url = 'hallpartner.amelio.se',
} = Astro.props;
---

<figure class="browser-mockup">
  <div class="browser-mockup__chrome" aria-hidden="true">
    <span class="browser-mockup__dot"></span>
    <span class="browser-mockup__dot"></span>
    <span class="browser-mockup__dot"></span>
    <span class="browser-mockup__url">{url}</span>
  </div>
  <div
    class="media-placeholder browser-mockup__screen"
    data-label={imageLabel}
    role="img"
    aria-label={imageLabel}
  >
  </div>
  {
    caption && (
      <figcaption class="text-caption text-muted browser-mockup__caption">{caption}</figcaption>
    )
  }
</figure>

<style>
  .browser-mockup {
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-card-hover);
    border: var(--border-width) solid var(--color-border);
  }

  .browser-mockup__chrome {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-2) var(--space-3);
    background-color: var(--color-steel-dark);
  }

  .browser-mockup__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background-color: rgb(243 241 236 / 30%);
  }

  .browser-mockup__url {
    margin-left: var(--space-2);
    padding: 0.3rem 0.9rem;
    border-radius: var(--radius-pill);
    background-color: rgb(243 241 236 / 12%);
    color: var(--color-muted);
    font-size: var(--font-size-caption);
  }

  .browser-mockup__screen {
    --placeholder-aspect: 16 / 10;
    border-radius: 0;
  }

  .browser-mockup__caption {
    padding: var(--space-2) var(--space-1) 0;
  }
</style>
