---
// Lugn, icke-länkad checklista. Avsedd att användas på en mörk sektion
// (section-inverse) för att kännas som en trygg paus mitt i presentationen,
// tydligt skild från kortgridarna runt omkring.
import type { PreserveValueItem } from '../types/content';

export interface Props {
  items: PreserveValueItem[];
}

const { items } = Astro.props;
---

<ul class="preserve-values">
  {
    items.map((item) => (
      <li class="preserve-values__item">
        <span class="preserve-values__mark" aria-hidden="true" />
        <span>{item.title}</span>
      </li>
    ))
  }
</ul>

<style>
  .preserve-values {
    display: grid;
    gap: var(--space-1);
  }

  .preserve-values__item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-2);
    border-bottom: var(--border-width) solid var(--color-border-inverse);
    font-size: var(--font-size-body-lg);
    font-weight: var(--font-weight-medium);
  }

  .preserve-values__mark {
    position: relative;
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    border: 1.5px solid var(--color-accent-warm);
  }

  .preserve-values__mark::after {
    content: '';
    position: absolute;
    left: 0.4rem;
    top: 0.2rem;
    width: 0.35rem;
    height: 0.7rem;
    border-right: 2px solid var(--color-accent-warm);
    border-bottom: 2px solid var(--color-accent-warm);
    transform: rotate(40deg);
  }

  @media (min-width: 768px) {
    .preserve-values {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-1) var(--space-5);
    }
  }
</style>
