---
import ButtonLink from './ButtonLink.astro';
import type { CTA } from '../types/content';

export interface Props {
  title: string;
  text?: string;
  button: CTA;
  secondaryButton?: CTA;
}

const { title, text, button, secondaryButton } = Astro.props;
---

<section class="cta-section section-inverse section">
  <div class="container cta-section__inner">
    <h2>{title}</h2>
    {text && <p class="text-lead text-muted cta-section__text">{text}</p>}
    <div class="cta-section__actions">
      <ButtonLink href={button.href} label={button.label} variant="primary" />
      {
        secondaryButton && (
          <ButtonLink href={secondaryButton.href} label={secondaryButton.label} variant="secondary" />
        )
      }
    </div>
  </div>
</section>

<style>
  .cta-section__inner {
    max-width: var(--width-text);
    text-align: center;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .cta-section__text {
    color: var(--color-muted);
  }

  .cta-section__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
  }

  .cta-section__actions :global(.btn-secondary) {
    color: var(--color-off-white);
  }
</style>
