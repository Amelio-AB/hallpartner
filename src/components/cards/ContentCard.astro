---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  href: string;
  eyebrow?: string;
  title: string;
  text: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const { href, eyebrow, title, text, image, imageAlt = '' } = Astro.props;
---

<article class="content-card">
  {image && (
    <a class="content-card__media" href={href} tabindex="-1" aria-hidden="true">
      <Image
        src={image}
        alt={imageAlt}
        widths={[480, 720]}
        sizes="(min-width: 768px) 40vw, 100vw"
        loading="lazy"
      />
    </a>
  )}
  <div class="content-card__body">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h3><a href={href}>{title}</a></h3>
    <p>{text}</p>
  </div>
</article>

<style>
  .content-card {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .content-card__media {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .content-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .content-card:hover .content-card__media :global(img) {
    transform: scale(1.015);
  }

  .content-card__body {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
  }

  .content-card h3 a {
    text-decoration: none;
  }

  .content-card p:last-child {
    color: var(--color-text-muted);
  }
</style>
