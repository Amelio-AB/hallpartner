---
import BrandLogo from '../ui/BrandLogo.astro';
import ActionLink from '../ui/ActionLink.astro';
import {
  primaryNavigation,
  prototypeNavigation,
  prototypeCta,
  siteConfig,
} from '../../config/site';

export interface Props {
  currentPage?: string;
  prototype?: boolean;
}

const { currentPage = '/', prototype = false } = Astro.props;
const navigation = prototype ? prototypeNavigation : primaryNavigation;
const primaryCta = prototype ? prototypeCta : siteConfig.primaryCta;
const logoHref = prototype ? '/prototype/foundation/' : '/';

const isCurrent = (href: string) => {
  const pathname = href.split('#')[0] || '/';
  return pathname === '/'
    ? currentPage === '/'
    : currentPage.startsWith(pathname);
};
---

<header class="site-header">
  <div class="container site-header__inner">
    <BrandLogo href={logoHref} />

    <nav class="desktop-nav" aria-label="Primär navigation">
      <ul>
        {navigation.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <ActionLink href={primaryCta.href} label={primaryCta.label} variant="primary" />
    </nav>

    <details class="mobile-nav">
      <summary aria-label="Öppna huvudmenyn">
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span class="mobile-nav__label">Meny</span>
      </summary>
      <nav aria-label="Mobil navigation">
        <ul>
          {navigation.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
        <div class="mobile-nav__cta">
          <ActionLink href={primaryCta.href} label={primaryCta.label} variant="primary" />
        </div>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 100;
    top: 0;
    border-bottom: 1px solid rgb(46 46 46 / 9%);
    background: rgb(248 247 244 / 94%);
    backdrop-filter: blur(10px);
  }

  .site-header__inner {
    display: flex;
    min-height: 4.6rem;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .desktop-nav {
    display: none;
  }

  .desktop-nav ul,
  .mobile-nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .desktop-nav a,
  .mobile-nav nav a {
    color: var(--color-text);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
  }

  .desktop-nav a:hover,
  .mobile-nav nav a:hover,
  .desktop-nav a[aria-current='page'],
  .mobile-nav nav a[aria-current='page'] {
    color: var(--color-action);
  }

  .mobile-nav {
    position: relative;
  }

  .mobile-nav summary {
    display: grid;
    width: 3rem;
    height: 3rem;
    padding: 0.65rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    cursor: pointer;
    list-style: none;
    place-content: center;
  }

  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav summary > span:not(.mobile-nav__label) {
    display: block;
    width: 1.1rem;
    height: 1px;
    margin-block: 2px;
    background: var(--color-text);
  }

  .mobile-nav__label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .mobile-nav nav {
    position: absolute;
    top: calc(100% + 0.75rem);
    right: 0;
    width: min(20rem, calc(100vw - 2rem));
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
  }

  .mobile-nav nav ul {
    display: grid;
    gap: var(--space-3);
  }

  .mobile-nav__cta {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 72rem) {
    .mobile-nav {
      display: none;
    }

    .desktop-nav {
      display: flex;
      align-items: center;
      gap: var(--space-5);
    }

    .desktop-nav ul {
      display: flex;
      align-items: center;
      gap: var(--space-4);
    }
  }
</style>
