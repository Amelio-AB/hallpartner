---
import { Image } from 'astro:assets';
import lagerhall from '../../assets/images/lagerhall.jpg';
import maskinhall from '../../assets/images/maskinhall.jpeg';
import ridhus from '../../assets/images/legacy/H191567f7ad934fb6aa6520bd8eeeac08N-e1773849628844.jpg';
import '../../styles/hallpartner-home.css';

// Native visitor routes. Image sources and visual composition are unchanged.
const existingPages = {
  lagerhallar: '/stalhallar/lagerhall/',
  maskinhallar: '/stalhallar/maskinhall/',
  ridhus: '/stalhallar/ridhus/',
  isolerade: '/stalhallar/isolerad-hall/',
  kontakt: '/kontakt/',
  offert: '/offert/',
  process: '/sa-gar-det-till/',
} as const;
---

<div class="hp-home">
  <section class="hp-home-hero" aria-labelledby="hp-home-title" data-hero data-hero-tone="dark">
    <img
      src="/images/hallpartner-hero-temporary.webp"
      alt=""
      loading="eager"
      decoding="async"
      fetchpriority="high"
      class="hp-home-hero__background"
      width="1916"
      height="821"
    />
    <div class="hp-home-hero__overlay" aria-hidden="true"></div>
    <div class="hp-draft-rail hp-home-hero__grid">
      <div class="hp-home-hero__copy">
        <p class="hp-home-kicker"><span class="hp-home-kicker__line" aria-hidden="true"></span> Hallpartner / Totalentreprenad</p>
        <h1 id="hp-home-title">Nyckelfärdiga hallar.</h1>
        <p class="hp-home-hero__lead">
          Berätta vad hallen ska användas till. Hallpartner kan erbjuda totalentreprenad
          med en helt driftklar hall – från planering och grundarbete till montage och
          de installationer som ingår i offerten.
        </p>
        <div class="hp-home-actions">
          <a class="hp-home-button hp-home-button--primary" href={existingPages.offert}>
            Be om offert
            <span aria-hidden="true">→</span>
          </a>
          <a class="hp-home-textlink" href="#halltyper">
            Utforska halltyper
            <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
    </div>
    <div class="hp-home-hero__edge" aria-hidden="true"></div>
  </section>

  <div class="hp-home-overview" aria-label="Välj ingång">
    <div class="hp-draft-rail hp-home-overview__inner">
      <p>Från behov till färdig hall</p>
      <span aria-hidden="true" class="hp-home-overview__line"></span>
      <a href="#halltyper">Se halltyper <span aria-hidden="true">↓</span></a>
      <a href="#att-tanka-pa">Inför första samtalet <span aria-hidden="true">↓</span></a>
    </div>
  </div>

  <section id="halltyper" class="hp-home-section hp-home-types" aria-labelledby="hp-home-types-title">
    <div class="hp-draft-rail">
      <div class="hp-home-heading-row">
        <div>
          <p class="hp-home-kicker hp-home-kicker--dark">Hitta rätt ingång</p>
          <h2 id="hp-home-types-title">Vad ska hallen användas till?</h2>
        </div>
        <p class="hp-home-section-lead">
          Lager, maskiner och ridverksamhet har olika behov. Vi börjar med
          användningen och hjälper dig att hitta ett passande utförande.
        </p>
      </div>
      <div class="hp-home-type-grid">
        <article class="hp-home-type">
          <a class="hp-home-type__link" href={existingPages.lagerhallar} aria-label="Läs om lagerhallar">
            <div class="hp-home-type__image">
              <Image src={lagerhall} alt="Hallbyggnad som illustrerar temat lager." loading="eager" />
            </div>
            <div class="hp-home-type__body">
              <div>
                <h3>Lagerhallar</h3>
                <p>För lagring av varor, med utrymme för in- och utleveranser.</p>
              </div>
              <span class="hp-home-type__arrow" aria-hidden="true">→</span>
            </div>
          </a>
        </article>
        <article class="hp-home-type">
          <a class="hp-home-type__link" href={existingPages.maskinhallar} aria-label="Läs om maskinhallar">
            <div class="hp-home-type__image">
              <Image src={maskinhall} alt="Hallbyggnad som illustrerar temat maskiner." loading="eager" />
            </div>
            <div class="hp-home-type__body">
              <div>
                <h3>Maskinhallar</h3>
                <p>För maskiner och fordon, med plats för portar, rörelser och arbete.</p>
              </div>
              <span class="hp-home-type__arrow" aria-hidden="true">→</span>
            </div>
          </a>
        </article>
        <article class="hp-home-type">
          <a class="hp-home-type__link" href={existingPages.ridhus} aria-label="Läs om ridhus">
            <div class="hp-home-type__image">
              <Image
                src={ridhus}
                alt="Ridhus med upplyst ridbana och ryttare."
                widths={[320, 480, 768, 1000]}
                sizes="(max-width: 560px) calc(100vw - 2rem), (max-width: 800px) calc(100vw - 2.4rem), (max-width: 1260px) 32vw, 393px"
                loading="lazy"
                style="object-position: center 65%;"
              />
            </div>
            <div class="hp-home-type__body">
              <div>
                <h3>Ridhus</h3>
                <p>För ridverksamhet, där ridyta, tillträde och ljus behöver fungera.</p>
              </div>
              <span class="hp-home-type__arrow" aria-hidden="true">→</span>
            </div>
          </a>
        </article>
      </div>
      <div class="hp-home-types__bottom">
        <p>Läs mer om användningsområden och olika hallsystem.</p>
        <a href="/stalhallar/">Se hela hallöversikten <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="hp-home-perspective" aria-labelledby="hp-home-perspective-title">
    <div class="hp-draft-rail hp-home-perspective__grid">
      <div class="hp-home-perspective__statement">
        <p class="hp-home-kicker hp-home-kicker--dark">Totalentreprenad när du vill ha helheten</p>
        <h2 id="hp-home-perspective-title">En kontaktväg.<br /><em>En driftklar hall.</em></h2>
      </div>
      <div class="hp-home-perspective__text">
        <p>
          Med totalentreprenad kan Hallpartner hålla ihop projektering, grundarbete,
          leverans, montage och installationer. Vi anlitar underentreprenörer för
          de delar av arbetet som utförs av andra företag.
        </p>
        <p>
          Vi kan också hjälpa till med bygglovsprocessen och kontakten med kommunen.
          Vilka arbeten som ingår och vilket ansvar Hallpartner tar framgår av
          offerten och avtalet för ditt projekt.
        </p>
        <a href={existingPages.process}>Se vägen till en färdig hall <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section id="att-tanka-pa" class="hp-home-planning" aria-labelledby="hp-home-planning-title">
    <div class="hp-draft-rail hp-home-planning__grid">
      <div class="hp-home-planning__intro">
        <p class="hp-home-kicker">Inför första samtalet</p>
        <h2 id="hp-home-planning-title">Du behöver inte ha en färdig ritning.</h2>
        <p>Beskriv vad du vill ha, ungefär hur mycket plats som behövs och var hallen ska stå. Vi hjälper dig vidare därifrån.</p>
      </div>
      <ul class="hp-home-planning__list">
        <li>
          <div><h3>Vad ska rymmas?</h3><p>Beskriv verksamheten och vad ytan främst ska användas till.</p></div>
        </li>
        <li>
          <div><h3>Hur ska hallen användas?</h3><p>Fundera på exempelvis infart, dagliga rörelser och behov av åtkomst.</p></div>
        </li>
        <li>
          <div><h3>Var är hallen tänkt att stå?</h3><p>Plats och förutsättningar behöver undersökas innan tekniska beslut kan fattas.</p></div>
        </li>
      </ul>
    </div>
  </section>

  <section class="hp-home-final" aria-labelledby="hp-home-final-title">
    <div class="hp-draft-rail hp-home-final__inner">
      <div>
        <p class="hp-home-kicker hp-home-kicker--dark">Nästa steg</p>
        <h2 id="hp-home-final-title">Vad behöver din färdiga hall klara?</h2>
        <p>Berätta hur du vill använda hallen. Vi går igenom vilken lösning och vilka arbeten som behövs för en driftklar leverans.</p>
      </div>
      <div class="hp-home-final__actions">
        <a class="hp-home-button hp-home-button--primary" href={existingPages.offert}>Be om offert <span aria-hidden="true">→</span></a>
        <a class="hp-home-textlink" href={existingPages.kontakt}>Ring eller mejla <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</div>
