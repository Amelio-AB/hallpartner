---
export interface Props {
  id?: string;
  title: string;
  category: string;
  readingTime: string;
  excerpt?: string;
  href: string;
}

const { id, title, category, readingTime, excerpt, href } = Astro.props;
---

<li class="card knowledge-card" id={id}>
  <a href={href} class="knowledge-card__link">
    <p class="text-caption knowledge-card__category">{category}</p>
    <h3 class="knowledge-card__title">{title}</h3>
    {excerpt && <p class="text-body text-muted">{excerpt}</p>}
    <p class="text-caption text-muted knowledge-card__meta">{readingTime} läsning</p>
  </a>
</li>

<style>
  .knowledge-card__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    color: inherit;
    text-decoration: none;
  }

  .knowledge-card__category {
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: var(--font-weight-semibold);
  }

  .knowledge-card__title {
    font-size: var(--font-size-h3);
  }

  .knowledge-card__link:hover .knowledge-card__title,
  .knowledge-card__link:focus-visible .knowledge-card__title {
    color: var(--color-accent);
  }

  .knowledge-card__meta {
    margin-top: var(--space-1);
  }
</style>
