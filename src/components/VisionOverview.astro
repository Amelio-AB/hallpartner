---
import InternalLinkCard from './InternalLinkCard.astro';
import type { LinkCardItem } from '../types/content';

export interface Props {
  items: LinkCardItem[];
}

const { items } = Astro.props;
---

<ul class="grid grid-2-up grid-3-up">
  {
    items.map((item) => (
      <InternalLinkCard
        title={item.title}
        description={item.description}
        href={item.href}
        linkLabel={item.linkLabel}
      />
    ))
  }
</ul>
