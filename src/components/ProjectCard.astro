---
import { Image } from 'astro:assets';
import ButtonLink from './ButtonLink.astro';
import type { ImageMetadata } from 'astro';

export interface Props {
  id?: string;
  title: string;
  category: string;
  image: ImageMetadata;
  imageAlt: string;
  description: string;
  href: string;
  linkLabel: string;
}

const { id, title, category, image, imageAlt, description, href, linkLabel } = Astro.props;
---

<li class="card project-card" id={id}>
  <article class="project-card__inner">
    <div class="project-card__media">
      <Image
        src={image}
        alt={imageAlt}
        class="project-card__image"
        widths={[480, 768, 960]}
        sizes="(min-width: 1024px) 30vw, (min-width: 768px) 50vw, 100vw"
        loading="lazy"
      />
    </div>
    <div class="project-card__body">
      <p class="text-caption project-card__meta">{category}</p>
      <h3 class="project-card__title">{title}</h3>
      <p class="text-body text-muted">{description}</p>
      <div class="project-card__action">
        <ButtonLink href={href} label={linkLabel} variant="ghost" />
      </div>
    </div>
  </article>
</li>

<style>
  .project-card {
    padding: 0;
    overflow: hidden;
  }

  .project-card__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .project-card__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-card) var(--radius-card) 0 0;
  }

  .project-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-zoom);
  }

  .project-card:hover .project-card__image,
  .project-card:focus-within .project-card__image {
    transform: scale(1.04);
  }

  .project-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: var(--space-3);
  }

  .project-card__meta {
    margin-bottom: var(--space-1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    font-weight: var(--font-weight-semibold);
  }

  .project-card__title {
    font-size: var(--font-size-h3);
    margin-bottom: var(--space-2);
  }

  .project-card__action {
    margin-top: auto;
    padding-top: var(--space-3);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card:hover .project-card__image,
    .project-card:focus-within .project-card__image {
      transform: none;
    }
  }
</style>
