---
export interface Props {
  id?: string;
  title: string;
  category: string;
  location: string;
  image: string;
  description: string;
  href: string;
}

const { id, title, category, location, image, description, href } = Astro.props;
---

<li class="card project-card" id={id}>
  <a href={href} class="project-card__link">
    <div
      class="media-placeholder project-card__media"
      data-label={image}
      role="img"
      aria-label={image}
    >
    </div>
    <div class="project-card__body">
      <p class="text-caption text-muted project-card__meta">{category} · {location}</p>
      <h3 class="project-card__title">
        {title}
        <span class="project-card__arrow" aria-hidden="true">→</span>
      </h3>
      <p class="text-body text-muted">{description}</p>
    </div>
  </a>
</li>

<style>
  .project-card {
    padding: 0;
    overflow: hidden;
  }

  .project-card__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .project-card__media {
    --placeholder-aspect: 4 / 3;
    border-radius: 0;
    transition: transform var(--transition-zoom);
  }

  .project-card__link:hover .project-card__media,
  .project-card__link:focus-visible .project-card__media {
    transform: scale(1.04);
  }

  .project-card__body {
    padding: var(--space-3);
  }

  .project-card__meta {
    margin-bottom: var(--space-1);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .project-card__title {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--font-size-h3);
    margin-bottom: var(--space-1);
  }

  .project-card__arrow {
    transition: transform var(--transition-base);
  }

  .project-card__link:hover .project-card__arrow,
  .project-card__link:focus-visible .project-card__arrow {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card__media,
    .project-card__arrow {
      transition: none;
    }

    .project-card__link:hover .project-card__media,
    .project-card__link:focus-visible .project-card__media {
      transform: none;
    }
  }
</style>
