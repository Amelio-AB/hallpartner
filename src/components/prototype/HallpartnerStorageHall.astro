---
import { Image } from 'astro:assets';
import lagerhall from '../../assets/images/lagerhall.jpg';
import maskinhall from '../../assets/images/maskinhall.jpeg';

const base = '/prototype/hallpartner/';
const preparations = [
  {
    heading: 'Vad behöver få plats?',
    detail: 'Börja med typen av gods, uppskattad mängd och om det handlar om tillfällig eller mer varaktig förvaring.',
  },
  {
    heading: 'Hur ska varor komma in och ut?',
    detail: 'Fundera på fordon, portöppningar och var in- och utlastning behöver fungera. Inga portmått är bestämda här.',
  },
  {
    heading: 'Vad behöver vara tillgängligt?',
    detail: 'Beskriv gångar, hantering och de delar av lagret som måste nås ofta. Det hjälper inför nästa samtal.',
  },
  {
    heading: 'Var ska hallen placeras?',
    detail: 'Platsens förutsättningar behöver undersökas före beslut om dimensionering, markarbete eller bygglov.',
  },
] as const;
---

<div class="hp-storage">
  <section class="hp-storage-hero" aria-labelledby="hp-storage-title">
    <div class="hp-draft-rail hp-storage-hero__grid">
      <div class="hp-storage-hero__copy">
        <p class="hp-storage-eyebrow">Hallpartner <span aria-hidden="true">/</span> Lagerhallar</p>
        <h1 id="hp-storage-title">Mer plats för det som behöver förvaras.</h1>
        <p class="hp-storage-hero__lead">
          En lagerhall börjar med vad du ska förvara och hur ytan ska användas.
          Här samlar vi frågorna som hjälper dig beskriva ditt lagerbehov innan ett utförande väljs.
        </p>
        <div class="hp-storage-actions">
          <a class="hp-storage-button" href="#hp-storage-needs">Planera lagerbehovet <span aria-hidden="true">↓</span></a>
          <a class="hp-storage-textlink" href={base + 'kontakt/'}>Till kontaktutkastet <span aria-hidden="true">↗</span></a>
        </div>
        <p class="hp-storage-hero__aside">Intern arbetsversion. Detta är inte ett verifierat produktsortiment eller ett erbjudande om specifika hallmått.</p>
      </div>
      <figure class="hp-storage-hero__media">
        <Image
          src={lagerhall}
          alt="Hallbyggnad ur befintligt presentationsmaterial. Illustrationsbild, inte en verifierad leverans från Hallpartner."
          loading="eager"
          fetchpriority="high"
          class="hp-storage-hero__image"
        />
        <figcaption>Illustrationsbild för layouttest · bildrättigheter återstår att kontrollera</figcaption>
      </figure>
    </div>
  </section>

  <div class="hp-storage-jumplinks">
    <div class="hp-draft-rail hp-storage-jumplinks__inner">
      <p>På den här sidan</p>
      <a href="#hp-storage-needs">Lagerbehov <span aria-hidden="true">↓</span></a>
      <a href="#hp-storage-flow">Åtkomst och flöde <span aria-hidden="true">↓</span></a>
      <a href="#hp-storage-next">Nästa steg <span aria-hidden="true">↓</span></a>
    </div>
  </div>

  <section id="hp-storage-needs" class="hp-storage-needs" aria-labelledby="hp-storage-needs-title">
    <div class="hp-draft-rail">
      <div class="hp-storage-heading">
        <div>
          <p class="hp-storage-eyebrow">Börja med användningen</p>
          <h2 id="hp-storage-needs-title">Ett lager ska fungera i vardagen.</h2>
        </div>
        <p>
          Det är lätt att börja med storleken på byggnaden. Men ytan måste också
          passa det som ska ställas in, flyttas och hämtas ut.
          Därför är användningen en bättre första fråga än materialvalet.
        </p>
      </div>
      <div class="hp-storage-needs__grid">
        {preparations.map((item) => (
          <article class="hp-storage-need">
            <span class="hp-storage-need__marker" aria-hidden="true"></span>
            <h3>{item.heading}</h3>
            <p>{item.detail}</p>
          </article>
        ))}
      </div>
      <p class="hp-storage-note">Punkterna är ett diskussionsunderlag, inte projektering eller ett besked om vad Hallpartner levererar.</p>
    </div>
  </section>

  <section id="hp-storage-flow" class="hp-storage-flow" aria-labelledby="hp-storage-flow-title">
    <div class="hp-draft-rail hp-storage-flow__grid">
      <figure class="hp-storage-flow__media">
        <Image
          src={maskinhall}
          alt="Hallmiljö i demonstrationsmaterial, använd för att bedöma bildkomposition. Inte ett verifierat lagerprojekt."
          loading="lazy"
        />
        <figcaption>Illustration · inte ett referensprojekt</figcaption>
      </figure>
      <div class="hp-storage-flow__copy">
        <p class="hp-storage-eyebrow">Praktiska frågor</p>
        <h2 id="hp-storage-flow-title">Tänk på vägen genom hallen.</h2>
        <p>
          Om varor ska flyttas ofta blir åtkomsten minst lika viktig som den totala golvytan.
          Rita gärna enkelt var du tänker dig inlastning, förvaring och de ytor som måste hållas fria.
        </p>
        <p>
          Vilka öppningar, ytor och konstruktionslösningar som verkligen fungerar får avgöras
          först när projektets förutsättningar och tillgängliga produkter är verifierade.
        </p>
        <a href={base + 'hallar/'} class="hp-storage-inline-link">Jämför halltyper och utföranden <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section id="hp-storage-next" class="hp-storage-final" aria-labelledby="hp-storage-next-title">
    <div class="hp-draft-rail hp-storage-final__grid">
      <div>
        <p class="hp-storage-eyebrow">Nästa steg</p>
        <h2 id="hp-storage-next-title">Beskriv lagret du har i åtanke.</h2>
        <p>
          Börja med vad du behöver förvara, ungefärligt platsbehov och var hallen är tänkt att stå.
          Kontaktvägen är ännu ett arbetsutkast; inget formulär skickar meddelanden i prototypen.
        </p>
      </div>
      <a class="hp-storage-button" href={base + 'kontakt/'}>Se kontaktutkastet <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <p class="hp-draft-rail hp-storage-disclaimer">
    Ursprungligt fulltextutkast saknas. Sidans texter och bilder är en visuell arbetsversion
    för granskning, inte kundgodkänd produktinformation. Sortiment, tjänsteomfattning och
    rättigheter till bilder måste bekräftas innan publicering.
  </p>
</div>

<style>
  .hp-storage { overflow: clip; background: var(--hp-offwhite); }
  .hp-storage *, .hp-storage *::before, .hp-storage *::after { box-sizing: border-box; }
  .hp-storage a { text-decoration: none; }
  .hp-storage h1, .hp-storage h2, .hp-storage h3, .hp-storage p, .hp-storage figure { margin: 0; }
  .hp-storage-eyebrow {
    margin-bottom: 1.25rem !important;
    color: #46664e; font-size: .74rem; font-weight: 750;
    letter-spacing: .13em; text-transform: uppercase; line-height: 1.45;
  }
  .hp-storage-eyebrow span { color: #8e9c93; padding-inline: .4rem; }
  .hp-storage-hero { background: #e1e5df; }
  .hp-storage-hero__grid {
    display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr);
    gap: clamp(2rem, 5vw, 5.7rem); min-height: 620px; align-items: center;
  }
  .hp-storage-hero__copy { padding-block: clamp(3.5rem, 7vw, 6.8rem); }
  .hp-storage h1 {
    font-size: clamp(3rem, 5.4vw, 5.6rem); line-height: 1.07;
    letter-spacing: -.066em; font-weight: 720; max-width: 12ch;
    text-wrap: balance;
  }
  .hp-storage-hero__lead {
    max-width: 520px; margin-top: 1.6rem !important;
    color: #48534b; font-size: clamp(1.04rem, 1.35vw, 1.18rem);
    line-height: 1.72;
  }
  .hp-storage-actions { display: flex; align-items: center; flex-wrap: wrap; gap: .8rem 1.5rem; margin-top: 2rem; }
  .hp-storage-button {
    display: inline-flex; justify-content: space-between; align-items: center;
    gap: 1.8rem; min-height: 3.35rem; padding: .95rem 1.18rem;
    background: var(--hp-cta); color: #fff !important;
    border-radius: 4px; font-weight: 730; font-size: .92rem; line-height: 1.3;
  }
  .hp-storage-button:hover { background: var(--hp-cta-hover); }
  .hp-storage-textlink, .hp-storage-inline-link {
    display: inline-flex; align-items: center; gap: .75rem; min-height: 2.8rem;
    color: #275339 !important; font-size: .9rem; font-weight: 710;
  }
  .hp-storage-textlink:hover, .hp-storage-inline-link:hover { text-decoration: underline; text-underline-offset: .3em; }
  .hp-storage-hero__aside {
    margin-top: 2.2rem !important; max-width: 450px; color: #647169;
    font-size: .74rem; line-height: 1.65;
  }
  .hp-storage-hero__media {
    position: relative; align-self: stretch; margin: 2.8rem 0 2.8rem;
    min-height: 470px; overflow: hidden; background: #a7b3a8;
  }
  .hp-storage-hero__image { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hp-storage-hero__media figcaption, .hp-storage-flow__media figcaption {
    position: absolute; bottom: .8rem; left: .8rem; right: .8rem;
    width: fit-content; max-width: calc(100% - 1.6rem);
    padding: .5rem .7rem; background: rgba(32, 36, 39, .87);
    color: #f4f4f0; font-size: .68rem; line-height: 1.4;
  }
  .hp-storage-jumplinks { border-bottom: 1px solid #c6cfc6; background: #f7f8f4; }
  .hp-storage-jumplinks__inner {
    display: flex; align-items: center; flex-wrap: wrap;
    gap: .8rem 2.1rem; min-height: 4.6rem; padding-block: .8rem;
  }
  .hp-storage-jumplinks p { color: #66746b; font-size: .78rem; font-weight: 600; margin-right: auto; }
  .hp-storage-jumplinks a { color: #344f3c; font-size: .83rem; font-weight: 700; }
  .hp-storage-jumplinks a:hover { text-decoration: underline; }
  .hp-storage-needs { padding-block: clamp(4rem, 8.5vw, 7.8rem); }
  .hp-storage-heading {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .75fr);
    align-items: end; gap: 2rem 7rem; margin-bottom: clamp(2.5rem, 5vw, 5rem);
  }
  .hp-storage h2 {
    max-width: 15ch; font-size: clamp(2.35rem, 4.2vw, 4.3rem);
    line-height: 1.13; letter-spacing: -.055em; font-weight: 700; text-wrap: balance;
  }
  .hp-storage-heading > p { max-width: 490px; color: #506058; font-size: 1rem; line-height: 1.85; }
  .hp-storage-needs__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 3rem; }
  .hp-storage-need { position: relative; padding-block: 2rem 2.25rem; border-top: 1px solid #aebbb0; }
  .hp-storage-need__marker { display: block; width: 1.7rem; height: 2px; background: #557d5e; margin-bottom: 1.25rem; }
  .hp-storage h3 { margin-bottom: .75rem; font-size: clamp(1.13rem, 1.5vw, 1.45rem); line-height: 1.3; letter-spacing: -.024em; }
  .hp-storage-need p { max-width: 500px; color: #536057; font-size: .95rem; line-height: 1.8; }
  .hp-storage-note { margin-top: 1.8rem !important; color: #647168; font-size: .76rem; line-height: 1.7; }
  .hp-storage-flow { padding-block: clamp(4rem, 8vw, 7.8rem); background: var(--hp-concrete); }
  .hp-storage-flow__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .9fr); gap: clamp(2rem, 7vw, 8rem); align-items: center; }
  .hp-storage-flow__media { position: relative; min-height: 460px; height: 100%; overflow: hidden; background: #7c8b80; }
  .hp-storage-flow__media img { display: block; height: 100%; width: 100%; object-fit: cover; }
  .hp-storage-flow__copy h2 { margin-bottom: 1.5rem; }
  .hp-storage-flow__copy > p:not(.hp-storage-eyebrow) { max-width: 540px; color: #46554c; line-height: 1.8; font-size: .99rem; margin-bottom: 1.15rem; }
  .hp-storage-flow__copy a { margin-top: .8rem; }
  .hp-storage-final { padding-block: clamp(4.5rem, 8vw, 7.5rem); background: var(--hp-deep); color: var(--hp-text-light); }
  .hp-storage-final__grid { display: flex; justify-content: space-between; align-items: center; gap: 2rem 5rem; }
  .hp-storage-final__grid > div { max-width: 690px; }
  .hp-storage-final .hp-storage-eyebrow { color: #bbd1be; }
  .hp-storage-final h2 { max-width: 16ch; }
  .hp-storage-final p:not(.hp-storage-eyebrow) { margin-top: 1.35rem; max-width: 620px; color: #ccd3ce; line-height: 1.8; }
  .hp-storage-final__grid > a { flex: 0 0 auto; }
  .hp-storage-disclaimer { padding-block: 1.3rem; color: #5b695e; font-size: .74rem; line-height: 1.7; }
  @media (max-width: 950px) {
    .hp-storage-hero__grid { gap: 2.4rem; }
    .hp-storage-hero__media { min-height: 410px; }
    .hp-storage-final__grid { align-items: start; flex-direction: column; }
  }
  @media (max-width: 800px) {
    .hp-storage-hero__grid, .hp-storage-flow__grid, .hp-storage-heading { grid-template-columns: minmax(0, 1fr); }
    .hp-storage-hero__grid { gap: 0; }
    .hp-storage-hero__copy { padding-block: 3.5rem 1.3rem; }
    .hp-storage-hero__media { min-height: 360px; height: 420px; margin: 1.2rem 0 2.5rem; }
    .hp-storage-heading { gap: 1.5rem; }
    .hp-storage-heading > p { max-width: 690px; }
    .hp-storage-flow__media { min-height: 370px; height: 390px; }
  }
  @media (max-width: 560px) {
    .hp-storage h1 { font-size: clamp(2.65rem, 11.3vw, 3.8rem); max-width: 11ch; }
    .hp-storage h2 { font-size: clamp(2.15rem, 8.8vw, 3.25rem); }
    .hp-storage-actions { align-items: stretch; flex-direction: column; gap: .4rem; }
    .hp-storage-button { width: 100%; }
    .hp-storage-hero__media { height: 310px; min-height: 310px; }
    .hp-storage-jumplinks__inner { gap: .75rem 1rem; }
    .hp-storage-jumplinks p { flex-basis: 100%; }
    .hp-storage-jumplinks a { font-size: .75rem; }
    .hp-storage-needs__grid { grid-template-columns: 1fr; }
    .hp-storage-need { padding-block: 1.5rem; }
    .hp-storage-flow__media { height: 285px; min-height: 285px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hp-storage-button { transition: none; }
  }
</style>
