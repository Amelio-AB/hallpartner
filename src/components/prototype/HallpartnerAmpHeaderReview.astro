---
import { renderFooter } from '@amelio/web-platform/footer';
import type { HeaderVariant } from '@amelio/web-platform/header-menu';
import HallpartnerHomePrototype from './HallpartnerHomePrototype.astro';
import { hallpartnerFooterConfig } from '../../config/hallpartner-footer.mjs';
import { ampHeaderItems, ampHeaderCTA } from '../../config/hallpartner-amp-header';
import '../../styles/hallpartner-draft.css';
import '../../styles/hallpartner-amp-footer.css';
import '../../styles/hallpartner-amp-header-review.css';
import '@amelio/web-platform/footer/style.css';
import '@amelio/web-platform/header-menu/style.css';

interface Props {
  variant: Extract<HeaderVariant, 'classic-dropdown' | 'classic-mega-menu'>;
  mode: 'hero' | 'solid';
}
const { variant, mode } = Astro.props;
const footerHtml = renderFooter({ ...hallpartnerFooterConfig, variant: 'compact' });
const reviewBase = '/prototype/amp/header/';
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="generator" content={Astro.generator} />
    <title>{variant === 'classic-mega-menu' ? 'AMP-002 Megameny' : 'AMP-002 Dropdown'} – Hallpartner intern granskning</title>
    <meta name="description" content="Intern noindexerad AMP-002 Header-granskning. Inte publicerad Hallpartner-webbplats." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
  </head>
  <body class="hp-draft hp-site hp-amp-header-review"
    data-header-variant={variant} data-header-mode={mode}>
    <a class="hp-draft-skip" href="#main-content">Hoppa till innehållet</a>
    <div id="hp-amp-header-target" aria-live="off"></div>

    <!-- Usable server navigation when JS is disabled or AMP mounting fails.
         Hide only after a successful AMP mount. -->
    <header id="hp-amp-header-fallback"
      class:list={['hp-draft-header', { 'hp-draft-header--overlay': mode === 'hero' }]}>
      <div class="hp-draft-rail hp-draft-header__inner">
        <a class="hp-draft-brand" href="/" aria-label="Hallpartner – startsida">
          <img class="hp-site-logo" src="/images/logo_text_white.png"
            alt="Hallpartner – Hallar till alla" width="1536" height="274" />
        </a>
        <nav class="hp-draft-nav" aria-label="Reservnavigation">
          {ampHeaderItems.map((item) => <a href={item.href}>{item.label}</a>)}
          <a class="hp-draft-nav__cta" href={ampHeaderCTA.href}>{ampHeaderCTA.label}</a>
        </nav>
      </div>
    </header>

    <main id="main-content" class="hp-draft-main" tabindex="-1">
      {mode === 'hero' ? (
        <HallpartnerHomePrototype variant="site" />
      ) : (
        <>
          <section class="hp-amp-solid-lead">
            <div class="hp-draft-rail">
              <p class="hp-amp-solid-lead__eyebrow">Hallpartner / Inför ditt projekt</p>
              <h1>Planera ditt hallprojekt.</h1>
              <p>Den här sidan visar AMP-002 med täckt Header utan bild-Hero. Innehållet är ett internt test, inte ett verifierat kundlöfte.</p>
              <a href="/sa-gar-det-till/">Läs om förberedelser <span aria-hidden="true">→</span></a>
            </div>
          </section>
          <section class="hp-amp-solid-body">
            <div class="hp-draft-rail">
              <h2>Vad behöver du få plats med?</h2>
              <p>Här kan vi kontrollera Headerns scrollbeteende på en vanlig undersida. Alla länkar går till redan skapade sidor.</p>
              <a href="/stalhallar/">Utforska halltyper</a>
            </div>
          </section>
        </>
      )}
      <nav class="hp-amp-review-options hp-draft-rail" aria-label="AMP-002 testvyer">
        <p><strong>AMP-002 – intern granskning.</strong> Du ser plattformskomponenten på Hallpartners arbetsdesign. Den riktiga startsidan och övriga besökarsidor är orörda.</p>
        <div>
          <a href={reviewBase} aria-current={variant === 'classic-dropdown' && mode === 'hero' ? 'page' : undefined}>Dropdown + bild-Hero</a>
          <a href={reviewBase + 'mega/'} aria-current={variant === 'classic-mega-menu' ? 'page' : undefined}>Megameny + bild-Hero</a>
          <a href={reviewBase + 'solid/'} aria-current={mode === 'solid' ? 'page' : undefined}>Megameny + täckt Header</a>
          <a href={reviewBase + 'mega/?tone=light'}>Megameny + ljust Hero-tonläge (kontrasttest)</a>
          <a href="/">Till godkänd startsida</a>
        </div>
      </nav>
    </main>
    <Fragment set:html={footerHtml} />
    <script>
      import { mountHeaderMenu } from '@amelio/web-platform/header-menu';
      import { ampHeaderItems, ampHeaderBrand, ampHeaderCTA, ampHeaderTheme, ampReviewVariants } from '../../config/hallpartner-amp-header';

      const body = document.body;
      const mountTarget = document.getElementById('hp-amp-header-target');
      const fallback = document.getElementById('hp-amp-header-fallback');
      const hero = document.querySelector<HTMLElement>('.hp-home-hero[data-hero]');
      const requestedVariant = body.dataset.headerVariant;
      const variant = ampReviewVariants.includes(requestedVariant as (typeof ampReviewVariants)[number])
        ? requestedVariant as (typeof ampReviewVariants)[number]
        : 'classic-dropdown';

      // The real AMP-002 product owns overlay, scroll, modal and keyboard state.
      if (mountTarget && fallback) {
        try {
          const instance = mountHeaderMenu(mountTarget, {
            variant,
            mobileToggleAppearance: 'icon',
            brand: ampHeaderBrand,
            items: ampHeaderItems,
            cta: ampHeaderCTA,
            currentPath: body.dataset.headerMode === 'hero' ? '/' : '/sa-gar-det-till/',
            theme: ampHeaderTheme,
            overlayHero: Boolean(hero),
            heroElement: hero,
            // Light is a visual contrast stress test on the same actual Hallpartner photo.
            heroTone: new URLSearchParams(window.location.search).get('tone') === 'light' ? 'light' : 'dark',
            scroll: { hideDistance: 24, revealDistance: 48, heroPrehideDistance: 160 },
          });
          fallback.hidden = true;
          body.dataset.ampReady = 'true';
          window.addEventListener('pagehide', () => instance.destroy(), { once: true });
        } catch (error) {
          console.error('AMP-002 review mount failed; server navigation retained.', error);
          mountTarget.replaceChildren();
          body.dataset.ampReady = 'false';
        }
      }
    </script>
  </body>
</html>
