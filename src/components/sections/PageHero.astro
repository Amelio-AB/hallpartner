---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ActionLink from '../ui/ActionLink.astro';

export interface HeroAction {
  label: string;
  href: string;
}

export interface Props {
  eyebrow?: string;
  title: string;
  intro: string;
  image?: ImageMetadata;
  imageAlt?: string;
  primaryAction?: HeroAction;
  secondaryAction?: HeroAction;
}

const {
  eyebrow,
  title,
  intro,
  image,
  imageAlt = '',
  primaryAction,
  secondaryAction,
} = Astro.props;
---

<section class="page-hero">
  <div class="container page-hero__grid">
    <div class="page-hero__content">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      <p class="lead">{intro}</p>

      {(primaryAction || secondaryAction) && (
        <div class="page-hero__actions">
          {primaryAction && (
            <ActionLink
              href={primaryAction.href}
              label={primaryAction.label}
              variant="primary"
            />
          )}
          {secondaryAction && (
            <ActionLink
              href={secondaryAction.href}
              label={secondaryAction.label}
              variant="secondary"
            />
          )}
        </div>
      )}
    </div>

    <div class="page-hero__media">
      {image ? (
        <Image
          src={image}
          alt={imageAlt}
          widths={[640, 960, 1280]}
          sizes="(min-width: 900px) 48vw, 100vw"
          loading="eager"
        />
      ) : (
        <div class="page-hero__placeholder" aria-hidden="true">
          <span>Bildyta</span>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .page-hero {
    padding-block: var(--space-6) var(--space-7);
  }

  .page-hero__grid {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  .page-hero__content {
    display: grid;
    gap: var(--space-4);
  }

  .page-hero__content h1 {
    max-width: 11ch;
  }

  .page-hero__content .lead {
    max-width: 40rem;
  }

  .page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-2);
  }

  .page-hero__media {
    min-height: 20rem;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-pale-stone);
    box-shadow: var(--shadow-soft);
  }

  .page-hero__media :global(img) {
    width: 100%;
    height: 100%;
    min-height: 20rem;
    object-fit: cover;
  }

  .page-hero__placeholder {
    display: grid;
    min-height: 20rem;
    place-items: center;
    color: var(--color-text-muted);
    background:
      linear-gradient(135deg, rgb(255 255 255 / 30%), transparent),
      var(--color-pale-stone);
  }

  @media (min-width: 56rem) {
    .page-hero {
      padding-block: var(--space-7) var(--space-8);
    }

    .page-hero__grid {
      grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
      gap: var(--space-7);
    }

    .page-hero__media,
    .page-hero__media :global(img),
    .page-hero__placeholder {
      min-height: 34rem;
    }
  }
</style>
